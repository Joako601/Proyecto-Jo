@model ProyectoJo.Web.Models.DashboardViewModel
@{
    ViewData["Title"] = "Panel de Control";
    Layout = "_Layout";
}

<div class="tc-topbar">
    <div>
        <h2>Panel administrativo</h2>
        <span class="tc-date">@DateTime.Today.ToString("dd/MM/yyyy")</span>
    </div>
    <div class="tc-topbar__right">
        <div class="tc-user-chip">
            <div class="tc-user-chip__avatar">J</div>
            <span class="tc-user-chip__name">Joaquín</span>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="tc-ticket">
            <div class="tc-label">Platillos activos</div>
            <div class="tc-value">@Model.TotalPlatillos</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="tc-ticket">
            <div class="tc-label">Ventas hoy</div>
            <div class="tc-value tc-value--teal">$@Model.VentasHoy.ToString("N0")</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="tc-ticket">
            <div class="tc-label">Pendientes</div>
            <div class="tc-value tc-value--mustard">@Model.PendientesHoy</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="tc-ticket">
            <div class="tc-label">Opiniones</div>
            <div class="tc-value">12</div>
        </div>
    </div>
</div>

<hr class="tc-section-divider" />

<div class="tc-section-label">Módulos</div>
<div class="row g-3">
    <div class="col-md-3">
        <a asp-area="Admin" asp-controller="Finanzas" asp-action="Index" class="tc-modulo">
            <div class="tc-modulo__top">
                <div class="tc-modulo__title"><i class="bi bi-cash tc-icon--mustard"></i><span>Finanzas</span></div>
                <span class="tc-modulo__arrow">→</span>
            </div>
            <div class="tc-modulo__body">Ingresos y egresos del día.</div>
        </a>
    </div>
    <div class="col-md-3">
        <a asp-area="Admin" asp-controller="Finanzas" asp-action="Dashboard" class="tc-modulo">
            <div class="tc-modulo__top">
                <div class="tc-modulo__title"><i class="bi bi-bar-chart tc-icon--mustard"></i><span>Dashboard financiero</span></div>
                <span class="tc-modulo__arrow">→</span>
            </div>
            <div class="tc-modulo__body">Tendencias del mes.</div>
        </a>
    </div>
    <div class="col-md-3">
        <a asp-area="Admin" asp-controller="Menu" asp-action="Index" class="tc-modulo">
            <div class="tc-modulo__top">
                <div class="tc-modulo__title"><i class="bi bi-card-list tc-icon--teal"></i><span>Menú</span></div>
                <span class="tc-modulo__arrow">→</span>
            </div>
            <div class="tc-modulo__body">Platillos y categorías.</div>
        </a>
    </div>
    <div class="col-md-3">
        <a asp-area="Admin" asp-controller="Inventario" asp-action="Index" class="tc-modulo">
            <div class="tc-modulo__top">
                <div class="tc-modulo__title"><i class="bi bi-toggles tc-icon--teal"></i><span>Inventario</span></div>
                <span class="tc-modulo__arrow">→</span>
            </div>
            <div class="tc-modulo__body">Pausar platillos agotados.</div>
        </a>
    </div>
    <div class="col-md-3">
        <a asp-area="Admin" asp-controller="Promociones" asp-action="Index" class="tc-modulo">
            <div class="tc-modulo__top">
                <div class="tc-modulo__title"><i class="bi bi-megaphone tc-icon--mustard"></i><span>Promociones</span></div>
                <span class="tc-modulo__arrow">→</span>
            </div>
            <div class="tc-modulo__body">Ofertas y descuentos activos.</div>
        </a>
    </div>
    <div class="col-md-3">
        <a asp-area="Admin" asp-controller="MapaCalor" asp-action="Index" class="tc-modulo">
            <div class="tc-modulo__top">
                <div class="tc-modulo__title"><i class="bi bi-fire tc-icon--carbon"></i><span>Mapa de calor</span></div>
                <span class="tc-modulo__arrow">→</span>
            </div>
            <div class="tc-modulo__body">Horas pico y productos más vendidos.</div>
        </a>
    </div>
    <div class="col-md-3">
        <a asp-area="Admin" asp-controller="CierreCaja" asp-action="Index" class="tc-modulo">
            <div class="tc-modulo__top">
                <div class="tc-modulo__title"><i class="bi bi-safe tc-icon--brick"></i><span>Cierre de caja</span></div>
                <span class="tc-modulo__arrow">→</span>
            </div>
            <div class="tc-modulo__body">Apertura, cierre y reporte de ventas del día.</div>
        </a>
    </div>
    <div class="col-md-3">
        <a asp-area="Admin" asp-controller="HistorialAuditoria" asp-action="Index" class="tc-modulo">
            <div class="tc-modulo__top">
                <div class="tc-modulo__title"><i class="bi bi-clock-history tc-icon--carbon"></i><span>Auditoría</span></div>
                <span class="tc-modulo__arrow">→</span>
            </div>
            <div class="tc-modulo__body">Registro de cambios realizados en el sistema.</div>
        </a>
    </div>
</div>

<div class="tc-section-label mt-4">Próximamente</div>
<div class="row g-3">
    @{
        var proximamente = new List<(string T, string D, string Icon)>
        {
            ("Semáforo Feedback", "Gestión de opiniones.", "bi-emoji-smile"),
            ("Recetario Digital", "Cálculo de costos y rendimientos.", "bi-journal-text"),
            ("Alerta de Stock", "Insumos críticos.", "bi-exclamation-triangle")
        };
    }
    @foreach (var f in proximamente)
    {
        <div class="col-md-3">
            <div class="tc-modulo tc-modulo--pendiente">
                <div class="tc-modulo__top">
                    <div class="tc-modulo__title"><i class="bi @f.Icon"></i><span>@f.T</span></div>
                </div>
                <div class="tc-modulo__body">
                    @f.D
                    <div class="tc-modulo__pendiente-tag">Próximamente</div>
                </div>
            </div>
        </div>
    }
</div>