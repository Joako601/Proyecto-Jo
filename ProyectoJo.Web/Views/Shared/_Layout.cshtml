<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Proyecto Jo</title>

    <link rel="icon" type="image/png" sizes="32x32" href="~/img/favicon-32.png" asp-append-version="true">
    <link rel="icon" type="image/png" sizes="16x16" href="~/img/favicon-16.png" asp-append-version="true">
    <link rel="apple-touch-icon" sizes="180x180" href="~/img/favicon-180.png" asp-append-version="true">

    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;1,700&family=Montserrat:wght@300;400;600&family=Inter:wght@300;400;600&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link rel="stylesheet" href="~/css/home/variables.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout/layout.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body style="display: flex; flex-direction: column; min-height: 100vh;">

    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom py-3">
            <div class="container-fluid px-3 px-lg-5">

                <a class="navbar-brand" asp-controller="Home" asp-action="Index" style="font-family: 'Playfair Display', serif; font-weight: 700; font-size: 1.5rem;">
                    Proyecto Jo
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarPrincipal"
                        aria-controls="navbarPrincipal" aria-expanded="false" aria-label="Abrir menú de navegación">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse justify-content-end" id="navbarPrincipal">
                    <ul class="navbar-nav text-uppercase" style="font-size: 0.75rem; letter-spacing: 2px; font-weight: 600;">
                        <li class="nav-item"><a class="nav-link text-dark px-3" asp-controller="Home" asp-action="Index">Inicio</a></li>
                        <li class="nav-item"><a class="nav-link text-dark px-3" asp-controller="Menu" asp-action="Index">Menú</a></li>
                        <li class="nav-item"><a class="nav-link text-dark px-3" asp-controller="Ubicacion" asp-action="Ubicacion">Ubicación</a></li>
                        <li class="nav-item"><a class="nav-link text-dark px-3" asp-controller="Nosotros" asp-action="Index">Quienes somos</a></li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" style="flex: 1;">
        @RenderBody()
    </main>

    <footer class="main-footer">
        <div class="container">
            <div class="row gy-4">
                <div class="col-lg-4 col-md-6">
                    <h5 class="footer-title">PROYECTO JO</h5>
                    <p class="footer-text">Sistema de gestión administrativa y financiera.</p>
                    <p class="footer-text mb-0">
                        <i class="bi bi-geo-alt-fill footer-icon"></i>
                        Mérida, Yucatán, México
                    </p>
                </div>

                <div class="col-lg-2 col-md-6">
                    <h5 class="footer-title">EXPLORA</h5>
                    <ul class="list-unstyled mb-0">
                        <li><a asp-controller="Home" asp-action="Index" class="footer-link">Inicio</a></li>
                        <li><a asp-controller="Menu" asp-action="Index" class="footer-link">Menú</a></li>
                        <li><a asp-controller="Historia" asp-action="Historia" class="footer-link">Nuestra Historia</a></li>
                        <li><a asp-controller="Nosotros" asp-action="Index" class="footer-link">Quiénes Somos</a></li>
                        <li><a asp-controller="Ubicacion" asp-action="Ubicacion" class="footer-link">Ubicación</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h5 class="footer-title">HORARIO</h5>
                    <ul class="list-unstyled mb-3">
                        <li class="footer-schedule-row">
                            <span class="footer-text mb-0">Lun - Sáb</span>
                            <span class="footer-schedule-time">18:30 - 23:30</span>
                        </li>
                        <li class="footer-schedule-row">
                            <span class="footer-text mb-0">Domingos</span>
                            <span class="footer-schedule-time">07:00 - 13:00</span>
                        </li>
                    </ul>
                    <a href="https://wa.me/529990000000" target="_blank" rel="noopener noreferrer" class="footer-whatsapp-btn">
                        <i class="bi bi-whatsapp"></i> Pedir por WhatsApp
                    </a>
                </div>

                <div class="col-lg-3 col-md-6 text-md-start text-lg-end">
                    <h5 class="footer-title">REDES</h5>
                    <p class="footer-text">Síguenos para ver lo nuevo de la cocina.</p>
                    <div class="footer-socials">

                        <a href="#" rel="noopener noreferrer">
                            <i class="bi bi-instagram"></i>
                        </a>
                        <a href="#" rel="noopener noreferrer">
                            <i class="bi bi-tiktok"></i>
                        </a>
                        <a href="#" rel="noopener noreferrer">
                            <i class="bi bi-facebook"></i>
                        </a>
                    </div>
                </div>
            </div>

            <hr class="footer-divider" />

            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
                <p class="footer-copy mb-0">&copy; @DateTime.Now.Year Proyecto Jo. Todos los derechos reservados.</p>
                <div class="d-flex align-items-center gap-3">
                    <a asp-controller="Home" asp-action="Privacy" class="footer-copy-link">Aviso de Privacidad</a>
                    <p class="footer-copy mb-0">Hecho con <i class="bi bi-heart-fill" style="color:#b5a478;"></i> en Mérida, Yucatán.</p>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>