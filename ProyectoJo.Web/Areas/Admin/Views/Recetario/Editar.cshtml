@model ProyectoJo.Domain.Entities.Receta
@{
    ViewData["Title"] = "Editar receta";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var platillos = ViewBag.Platillos as List<ProyectoJo.Domain.Entities.Item> ?? new();

    var unidadLabels = new Dictionary<ProyectoJo.Domain.Entities.UnidadIngrediente, string>
    {
        { ProyectoJo.Domain.Entities.UnidadIngrediente.Kilogramo, "kg" },
        { ProyectoJo.Domain.Entities.UnidadIngrediente.Gramo, "g" },
        { ProyectoJo.Domain.Entities.UnidadIngrediente.Litro, "l" },
        { ProyectoJo.Domain.Entities.UnidadIngrediente.Mililitro, "ml" },
        { ProyectoJo.Domain.Entities.UnidadIngrediente.Unidad, "un" },
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/finanzas/finanzas-shared.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/finanzas/finanzas-form.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/recetario/recetario.css" asp-append-version="true" />
}

<div class="admin-form receta-admin-form">
    <div class="form-header">
        <a asp-area="Admin" asp-controller="Recetario" asp-action="Index" class="back-link">← Volver al recetario</a>
        <h1>Editar receta</h1>
    </div>

    <form asp-area="Admin" asp-controller="Recetario" asp-action="Editar" method="post" id="formReceta">
        <input type="hidden" asp-for="Id" />

        <div class="form-group">
            <label asp-for="ItemId">Platillo del menú</label>
            <select asp-for="ItemId" class="form-control">
                @foreach (var item in platillos)
                {
                    <option value="@item.Id" data-precio="@item.Precio.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"
                            selected="@(item.Id == Model.ItemId)">
                        @item.Platillo
                    </option>
                }
            </select>
            <span asp-validation-for="ItemId" class="field-error"></span>
            <span class="promo-hint">El nombre de la receta se toma del platillo seleccionado.</span>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label asp-for="Rendimiento">Rendimiento</label>
                <input asp-for="Rendimiento" class="form-control" type="number" min="1" id="inputRendimiento" />
                <span asp-validation-for="Rendimiento" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="UnidadRendimiento">Unidad</label>
                <select asp-for="UnidadRendimiento" class="form-control">
                    <option value="porciones">Porciones</option>
                    <option value="platos">Platos</option>
                    <option value="litros">Litros</option>
                    <option value="kilogramos">Kilogramos</option>
                </select>
                <span asp-validation-for="UnidadRendimiento" class="field-error"></span>
            </div>
        </div>

        <div class="form-group">
            <label>Ingredientes</label>
            <table class="admin-table receta-ingredientes-table" id="tablaIngredientes">
                <thead>
                    <tr>
                        <th>Ingrediente</th>
                        <th>Cantidad</th>
                        <th>Unidad</th>
                        <th>Costo unitario</th>
                        <th>Subtotal</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Ingredientes.Count; i++)
                    {
                        <tr class="fila-ingrediente">
                            <td><input name="Ingredientes[@i].Nombre" class="form-control-sm" value="@Model.Ingredientes[i].Nombre" /></td>
                            <td><input name="Ingredientes[@i].Cantidad" class="form-control-sm input-cantidad" type="number" step="0.01" min="0" value="@Model.Ingredientes[i].Cantidad" /></td>
                            <td>
                                <select name="Ingredientes[@i].Unidad" class="form-control-sm">
                                    @foreach (var u in unidadLabels)
                                    {
                                        <option value="@u.Key" selected="@(u.Key == Model.Ingredientes[i].Unidad)">@u.Value</option>
                                    }
                                </select>
                            </td>
                            <td><input name="Ingredientes[@i].CostoUnitario" class="form-control-sm input-costo" type="number" step="0.01" min="0" value="@Model.Ingredientes[i].CostoUnitario" /></td>
                            <td class="subtotal-celda">$@Model.Ingredientes[i].CostoTotal.ToString("N2")</td>
                            <td><button type="button" class="link-delete btn-quitar-fila">Quitar</button></td>
                        </tr>
                    }
                </tbody>
            </table>
            <button type="button" class="btn-secondary" id="btnAgregarIngrediente">
                Agregar ingrediente
            </button>
        </div>

        <div class="form-group">
            <label asp-for="Notas">Notas (opcional)</label>
            <textarea asp-for="Notas" class="form-control" rows="2">@Model.Notas</textarea>
        </div>

        <div class="receta-resumen-costo">
            <div class="resumen-item">
                <span class="resumen-label">Costo total</span>
                <span class="resumen-valor" id="resumenCostoTotal">$0.00</span>
            </div>
            <div class="resumen-item">
                <span class="resumen-label">Costo x porción</span>
                <span class="resumen-valor" id="resumenCostoPorcion">$0.00</span>
            </div>
            <div class="resumen-item">
                <span class="resumen-label">Margen estimado</span>
                <span class="resumen-valor" id="resumenMargen">—</span>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-primary">Guardar cambios</button>
            <a asp-area="Admin" asp-controller="Recetario" asp-action="Index" class="btn-cancel">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/recetario-form.js" asp-append-version="true"></script>
}