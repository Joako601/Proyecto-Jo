@{
    Layout = "_Layout";
    ViewData["Title"] = "Configurar dispositivo";
    ViewData["VolverTexto"] = "Volver";
    ViewData["VolverUrl"] = Url.Action("SalirSupervisor", "Auth", new { area = "Operaciones" });
}

<div class="d-flex justify-content-center align-items-center" style="min-height: 90vh;">
    <div class="card shadow-sm emparejar-card">
        <div class="card-body p-4">
            <p class="emparejar-eyebrow">Configuración por dispositivo</p>
            <h4 class="emparejar-titulo mb-4">¿Dónde va a funcionar esta pantalla?</h4>

            <form method="post" asp-area="Operaciones" asp-controller="Auth" asp-action="Emparejar">
                <div class="mb-3">
                    <div class="estacion-grid">
                        <input type="radio" class="btn-check" name="estacion" id="rolRecepcion" value="Recepcion" autocomplete="off" checked>
                        <label class="estacion-tile" for="rolRecepcion">
                            <span class="estacion-tile__icono"><i class="bi bi-receipt"></i></span>
                            <span class="estacion-tile__nombre">Recepción</span>
                        </label>

                        <input type="radio" class="btn-check" name="estacion" id="rolCocina" value="Cocina" autocomplete="off">
                        <label class="estacion-tile" for="rolCocina">
                            <span class="estacion-tile__icono"><i class="bi bi-egg-fried"></i></span>
                            <span class="estacion-tile__nombre">Cocina</span>
                        </label>
                    </div>
                </div>

                <button type="submit" class="btn btn-success btn-tactil w-100 mt-2">
                    Guardar y continuar
                </button>
            </form>
        </div>
    </div>
</div>