@model List<ProyectoJo.Web.Models.MenuItemViewModel>

@{
    ViewData["Title"] = "Menú - Tía Caro";
    var promosGenerales = (List<ProyectoJo.Domain.Entities.Promocion>)ViewBag.PromocionesGenerales;
}

@section Styles {
    <link rel="stylesheet" href="~/css//menu/menu.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/menu/menu-promos.css" asp-append-version="true" />
}

<div class="container py-5 mt-3">
    <div class="text-center mb-5 fade-in-up">
        <h1 style="font-family: 'Playfair Display', serif; color: #222; font-weight: 700; font-size: 4.5rem; margin-bottom: 0.1rem;">
            Antojitos Tía Caro
        </h1>

        <div class="mx-auto my-4" style="width: 80px; height: 3px; background-color: #b5a478;"></div>
    </div>

    @if (promosGenerales != null && promosGenerales.Any())
    {
        <div class="row justify-content-center mb-5 fade-in-up">
            @foreach (var promo in promosGenerales)
            {
                <div class="col-md-9 mb-3">
                    @if (!string.IsNullOrEmpty(promo.ImagenUrl))
                    {
                        <div class="promo-banner promo-banner--imagen">
                            <img class="promo-banner__bg" src="@promo.ImagenUrl" alt="@promo.Titulo" />
                            <div class="promo-banner__overlay"></div>
                            <div class="promo-banner__content">
                                <p class="promo-banner__titulo">@promo.Titulo</p>
                                @if (!string.IsNullOrEmpty(promo.Descripcion))
                                {
                                    <p class="promo-banner__descripcion">@promo.Descripcion</p>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="promo-banner promo-banner--color">
                            <div class="promo-banner__content">
                                <p class="promo-banner__titulo">@promo.Titulo</p>
                                @if (!string.IsNullOrEmpty(promo.Descripcion))
                                {
                                    <p class="promo-banner__descripcion">@promo.Descripcion</p>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }

    <div class="row justify-content-center mb-5 fade-in-up" style="animation-delay: 0.2s;">
        <div class="col-md-9">
            <p class="text-center text-uppercase mb-2" style="font-family: 'Inter', sans-serif; font-size: 0.7rem; letter-spacing: 2px; color: #888; font-weight: 600;">
                Categorías
            </p>
            <div class="menu-filters-wrapper">
                <div class="menu-filters text-center">
                    <button class="filter-btn active" data-filter="todos">Todos</button>
                    <button class="filter-btn" data-filter="panuchos">Panuchos</button>
                    <button class="filter-btn" data-filter="salbutes">Salbutes</button>
                    <button class="filter-btn" data-filter="tortas">Tortas</button>
                    <button class="filter-btn" data-filter="caldos">Caldos</button>
                    <button class="filter-btn" data-filter="hamburguesas">Hamburguesas</button>
                    <button class="filter-btn" data-filter="nachos">Nachos</button>
                    <button class="filter-btn" data-filter="burros">Burros</button>
                    <button class="filter-btn" data-filter="empanadas">Empanadas</button>
                    <button class="filter-btn" data-filter="tamales">Tamales</button>
                    <button class="filter-btn" data-filter="polcanes">Polcanes</button>
                    <button class="filter-btn" data-filter="bebidas">Bebidas</button>
                </div>
            </div>
        </div>
    </div>

    <div class="row justify-content-center" id="menu-container">
        @if (Model != null && Model.Any())
        {
            int delay = 1;
            @foreach (var vm in Model)
            {
                var item = vm.Platillo;
                <div class="col-md-9 mb-4 menu-item-card card-animate"
                     data-category="@item.Categoria.ToLower()"
                     style="animation-delay: @((delay % 4) * 0.08)s; @(item.Agotado ? "opacity: 0.5;" : "")">

                    <div class="card border-0 p-5 item-card"
                         style="background-color: #ffffff; box-shadow: 0 10px 30px rgba(0,0,0,0.03); border-radius: 2px;">
                        <div class="d-flex flex-column flex-md-row justify-content-between">

                            <div>
                                <div class="d-flex align-items-center gap-3 mb-1">
                                    <h2 style="font-family: 'Playfair Display', serif; color: #222; font-weight: 700; font-size: 2.2rem; margin-bottom: 0;">
                                        @item.Platillo
                                    </h2>
                                    @if (item.Agotado)
                                    {
                                        <span class="badge bg-secondary" style="font-size: 0.65rem; letter-spacing: 1px;">AGOTADO</span>
                                    }
                                    @if (vm.TienePromocion)
                                    {
                                        <span class="badge" style="background-color: #b5a478; font-size: 0.65rem; letter-spacing: 1px;">PROMOCIÓN</span>
                                    }
                                </div>
                                <p class="text-muted mb-5" style="font-family: 'Inter', sans-serif; font-size: 0.95rem;">
                                    @item.Descripcion
                                </p>
                                <span class="text-uppercase" style="color: #b5a478; font-size: 0.7rem; letter-spacing: 2px; font-weight: 600;">
                                    Base: @item.Base — @item.Categoria
                                </span>
                            </div>

                            <div class="text-md-end d-flex flex-column justify-content-between align-items-md-end mt-4 mt-md-0">
                                @if (vm.TienePromocion)
                                {
                                    <span class="text-muted text-decoration-line-through" style="font-size: 0.95rem;">$@item.Precio</span>
                                    <h3 style="color: #b5a478; font-weight: 600; font-size: 1.4rem;">
                                        $@vm.PrecioFinal
                                    </h3>
                                }
                                else
                                {
                                    <h3 style="color: #b5a478; font-weight: 400; font-size: 1.4rem;">
                                        $@item.Precio
                                    </h3>
                                }
                                @if (!item.Agotado)
                                {
                                    <a asp-controller="Menu" asp-action="Detalle" asp-route-id="@item.Id"
                                       class="ver-experiencia-link text-dark text-uppercase text-decoration-none">
                                        Ver Experiencia &rarr;
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted text-uppercase" style="font-size: 0.8rem; letter-spacing: 1px;">
                                        No disponible
                                    </span>
                                }
                            </div>

                        </div>
                    </div>
                </div>
                delay++;
            }
        }
    </div>

    @if ((int)ViewBag.TotalPaginas > 1)
    {
        <nav class="d-flex justify-content-center" aria-label="Paginación del menú">
            <ul class="menu-pagination">
                @{
                    int paginaActual = (int)ViewBag.PaginaActual;
                    int totalPaginas = (int)ViewBag.TotalPaginas;
                }
                <li class="page-item @(paginaActual <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-categoria="@ViewBag.CategoriaActual"
                       asp-route-pagina="@(paginaActual - 1)">&larr; Anterior</a>
                </li>

                @for (int i = 1; i <= totalPaginas; i++)
                {
                    <li class="page-item @(i == paginaActual ? "active" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-categoria="@ViewBag.CategoriaActual"
                           asp-route-pagina="@i">@i</a>
                    </li>
                }

                <li class="page-item @(paginaActual >= totalPaginas ? "disabled" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-categoria="@ViewBag.CategoriaActual"
                       asp-route-pagina="@(paginaActual + 1)">Siguiente &rarr;</a>
                </li>
            </ul>
        </nav>
    }
</div>

@section Scripts {
    <script src="~/js/filtrosMenu.js" asp-append-version="true"></script>
}