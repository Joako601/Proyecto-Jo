@model ProyectoJo.Domain.Entities.Item

@{
    ViewData["Title"] = "Editar platillo";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="mb-4">
    <a asp-area="Admin" asp-controller="Menu" asp-action="Index"
       class="text-muted text-decoration-none">
        <i class="bi bi-arrow-left"></i> Volver al menú
    </a>
</div>

<h2 class="mb-4">Editar platillo</h2>

<div class="row">
    <div class="col-md-7">
        <form asp-area="Admin" asp-controller="Menu" asp-action="Editar" method="post">
            <input asp-for="Id" type="hidden" />
            <div class="mb-3">
                <label asp-for="Platillo" class="form-label">Nombre del platillo</label>
                <input asp-for="Platillo" class="form-control" />
                <span asp-validation-for="Platillo" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Categoria" class="form-label">Categoría</label>
                <input asp-for="Categoria" class="form-control" />
                <span asp-validation-for="Categoria" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Base" class="form-label">Base</label>
                <input asp-for="Base" class="form-control" />
                <span asp-validation-for="Base" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Precio" class="form-label">Precio</label>
                <input asp-for="Precio" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="Precio" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Ingredientes" class="form-label">Ingredientes</label>
                <input asp-for="Ingredientes" class="form-control" />
                <span asp-validation-for="Ingredientes" class="text-danger small"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Descripcion" class="form-label">Descripción</label>
                <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Descripcion" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-lg"></i> Guardar cambios
            </button>
        </form>
    </div>
</div>