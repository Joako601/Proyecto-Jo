@model ProyectoJo.Domain.Entities.Insumo
@{
    ViewData["Title"] = "Editar insumo";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/finanzas/finanzas-shared.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/finanzas/finanzas-form.css" asp-append-version="true" />
}

<div class="admin-form">
    <div class="form-header">
        <a asp-area="Admin" asp-controller="Insumos" asp-action="Index" class="back-link">← Volver a Alerta de Stock</a>
        <h1>Editar insumo</h1>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert-error">
            @Html.ValidationSummary(false, "", new { @class = "validation-summary-errors" })
        </div>
    }

    <form asp-area="Admin" asp-controller="Insumos" asp-action="Editar" method="post">
        <input type="hidden" asp-for="Id" />

        <div class="form-group">
            <label asp-for="Nombre">Nombre</label>
            <input asp-for="Nombre" class="form-control" />
            <span asp-validation-for="Nombre" class="field-error"></span>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label asp-for="Unidad">Unidad</label>
                <select asp-for="Unidad" class="form-control">
                    <option value="0">Kilogramo</option>
                    <option value="1">Gramo</option>
                    <option value="2">Litro</option>
                    <option value="3">Mililitro</option>
                    <option value="4">Unidad</option>
                </select>
            </div>
            <div class="form-group">
                <label asp-for="StockActual">Stock actual</label>
                <input asp-for="StockActual" class="form-control" type="number" step="0.01" min="0" />
                <span asp-validation-for="StockActual" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="StockMinimo">Stock mínimo (alerta)</label>
                <input asp-for="StockMinimo" class="form-control" type="number" step="0.01" min="0" />
                <span asp-validation-for="StockMinimo" class="field-error"></span>
            </div>
        </div>

        <div class="form-group">
            <label class="d-flex align-items-center gap-2">
                <input asp-for="Activo" type="checkbox" style="width:auto;" /> Activo
            </label>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-primary">Guardar cambios</button>
            <a asp-area="Admin" asp-controller="Insumos" asp-action="Index" class="btn-secondary">Cancelar</a>
        </div>
    </form>
</div>