@{
    ViewData["Title"] = "Acceso";
    Layout = "_LayoutAuth";
}

<div class="tc-auth-card">
    <div class="tc-auth-card__brand">
        <h1>Proyecto Jo</h1>
        <span class="tc-auth-card__subtitle">PANEL ADMINISTRATIVO</span>
    </div>

    <hr class="tc-auth-card__divider" />

    @if (ViewBag.Error is string error)
    {
        <div class="tc-auth-card__error">@error</div>
    }

    <form asp-area="Admin" asp-controller="Login" asp-action="Index" method="post">
        @if (ViewBag.ReturnUrl is string returnUrl)
        {
            <input type="hidden" name="returnUrl" value="@returnUrl" />
        }
        <div class="tc-auth-field">
            <label for="usuario">Usuario</label>
            <input type="text" id="usuario" name="usuario" placeholder="Nombre de usuario" required />
        </div>

        <div class="tc-auth-field">
            <label for="contrasena">Contraseña</label>
            <input type="password" id="contrasena" name="contrasena" placeholder="••••••••" required />
        </div>

        <button type="submit" class="tc-auth-submit">Entrar</button>
    </form>
</div>