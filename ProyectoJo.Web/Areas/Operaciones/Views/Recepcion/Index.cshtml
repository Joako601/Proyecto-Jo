@using Microsoft.AspNetCore.Antiforgery
@inject IAntiforgery Antiforgery
@{
    Layout = null;
    var tokenSet = Antiforgery.GetAndStoreTokens(Context);
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
    <meta name="request-verification-token" content="@tokenSet.RequestToken">
    <link rel="manifest" href="~/manifest.json">
    <title>Recepción — Proyecto Jo'</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@500;600&family=Public+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/operaciones/recepcion.css" asp-append-version="true">
</head>
<body>
    <div class="top-bar">
        <div class="top-bar__brand">
            <span class="top-bar__icon">🧾</span>
            <h1 class="top-bar__title">Recepción</h1>
            @if (User.FindFirst("Dispositivo")?.Value is string nombreDisp && !string.IsNullOrWhiteSpace(nombreDisp))
            {
                <span class="top-bar__dispositivo">@nombreDisp</span>
            }
            <span id="estado-conexion" class="top-bar__estado"></span>
        </div>
        <a class="top-bar__salir" asp-area="Operaciones" asp-controller="Auth" asp-action="Salir">
            Cerrar sesión <span class="top-bar__empleado">(@User.Identity?.Name)</span>
        </a>
    </div>

    <div id="vista-switch" class="vista-switch">
        <button class="vista-switch__btn vista-switch__btn--activo" data-vista="pedir">🛒 Pedir</button>
        <button class="vista-switch__btn" data-vista="pedidos">📋 Pedidos</button>
    </div>

    <div class="toolbar">
        <div class="buscador-box">
            <span class="buscador-box__icono">🔍</span>
            <input id="buscador" class="buscador" placeholder="Buscar platillo..." autocomplete="off">
        </div>
    </div>

    <div id="chips-categoria" class="chips"></div>

    <div class="layout">
        <section class="col-menu">
            <button id="btn-volver-categorias" class="btn-volver-categorias">← Categorías</button>
            <div id="menu-grid" class="menu-grid">
                <p class="mensaje-vacio">Cargando menú...</p>
            </div>
        </section>

        <aside id="panel-carrito" class="panel-carrito">
            <div class="panel-carrito__header">
                <h2 class="seccion-titulo">Pedido actual</h2>
                <button id="cerrar-carrito" class="cerrar-carrito" aria-label="Cerrar pedido">✕</button>
            </div>

            <div class="carrito-box">
                <div class="tipo-entrega">
                    <button id="btn-mesa" class="tipo-entrega__btn tipo-entrega__btn--activo" data-tipo="mesa">
                        Para mesa
                    </button>
                    <button id="btn-llevar" class="tipo-entrega__btn" data-tipo="llevar">
                        Para llevar
                    </button>
                </div>

                <input id="mesa-input" class="mesa-input" placeholder="Número o nombre de mesa">

                <div id="carrito-lineas">
                    <p class="mensaje-vacio">Aún no has agregado productos.</p>
                </div>

                <div class="total" id="total-carrito">Total: $0.00</div>
                <button class="crear-btn" id="crear-btn" disabled>Crear pedido</button>
            </div>
        </aside>
    </div>

    <div id="carrito-overlay" class="carrito-overlay"></div>

    <div id="barra-mobile" class="barra-mobile">
        <div class="barra-mobile__info">
            <span id="barra-mobile-items">0 items</span>
            <span id="barra-mobile-total">$0.00</span>
        </div>
        <button id="btn-ver-pedido" class="barra-mobile__btn">Ver pedido</button>
    </div>

    <section id="seccion-pedidos">
        <div class="tabs">
            <button id="tab-activos" class="tabs__btn tabs__btn--activo" data-tab="activos">Pedidos activos</button>
            <button id="tab-pagados" class="tabs__btn" data-tab="pagados">Pagados</button>
        </div>

        <div id="pedidos-grid" class="pedidos-grid">
            <p class="mensaje-vacio">Cargando pedidos...</p>
        </div>
    </section>

    <div id="modal-confirmacion" class="modal" style="display:none;">
        <div id="modal-overlay" class="modal__overlay"></div>
        <div class="modal__caja">
            <h3 id="modal-titulo" class="modal__titulo"></h3>
            <p id="modal-cuerpo" class="modal__cuerpo"></p>
            <div class="modal__acciones">
                <button id="modal-cancelar" class="modal__btn modal__btn--secundario">Cancelar</button>
                <button id="modal-confirmar" class="modal__btn modal__btn--primario">Enviar sin ellos</button>
            </div>
        </div>
    </div>

    <script src="~/lib/signalr/signalr.min.js"></script>
    <script src="~/js/operaciones/recepcion.js" asp-append-version="true"></script>
</body>
</html>