@model ProyectoJo.Application.DTOs.ResumenMapaCalor
@{
    ViewData["Title"] = "Mapa de Calor de Ventas";
    Layout = "_Layout";

    var etiquetasHoras = System.Text.Json.JsonSerializer.Serialize(Model.VentasPorHora.Select(v => v.Etiqueta));
    var dataPedidosPorHora = System.Text.Json.JsonSerializer.Serialize(Model.VentasPorHora.Select(v => v.CantidadPedidos));

    var etiquetasDiasSemana = System.Text.Json.JsonSerializer.Serialize(Model.VentasPorDiaSemana.Select(v => v.Etiqueta));
    var dataPedidosPorDiaSemana = System.Text.Json.JsonSerializer.Serialize(Model.VentasPorDiaSemana.Select(v => v.CantidadPedidos));

    var diaMasVendedor = Model.VentasPorDiaSemana.OrderByDescending(v => v.TotalVendido).FirstOrDefault();

    var etiquetaRangoSemana = $"{Model.InicioSemana:dd/MM} - {Model.FinSemana:dd/MM/yyyy}";

    var etiquetasMeses = System.Text.Json.JsonSerializer.Serialize(Model.VentasPorMes.Select(v => v.Etiqueta));
    var dataPedidosPorMes = System.Text.Json.JsonSerializer.Serialize(Model.VentasPorMes.Select(v => v.CantidadPedidos));

    var mesActual = Model.MesDetalleSeleccionado ?? DateTime.Today.Month;
    var anioActual = Model.AnioMesesSeleccionado > 0 ? Model.AnioMesesSeleccionado : DateTime.Today.Year;

    var mesAnterior = mesActual == 1 ? 12 : mesActual - 1;
    var anioMesAnterior = mesActual == 1 ? anioActual - 1 : anioActual;
    var mesSiguiente = mesActual == 12 ? 1 : mesActual + 1;
    var anioMesSiguiente = mesActual == 12 ? anioActual + 1 : anioActual;
    var esHoy = anioActual == DateTime.Today.Year && mesActual == DateTime.Today.Month;

    var cultura = new System.Globalization.CultureInfo("es-MX");
    var etiquetaMesActual = cultura.DateTimeFormat.GetMonthName(mesActual) + " " + anioActual;

    var maxCantidadTop = Model.TopProductos.Any() ? Model.TopProductos.Max(p => p.CantidadVendida) : 0;

    var totalPedidosSemana = Model.VentasPorDiaSemana.Sum(d => d.CantidadPedidos);
    var totalVendidoSemana = Model.VentasPorDiaSemana.Sum(d => d.TotalVendido);

    // Solo tiene sentido "ver horas" de un día puntual cuando estamos parados
    // sobre una semana concreta (Por semana), no en el acumulado Histórico.
    Func<DayOfWeek, DateTime> fechaDelDia = dow =>
        Enumerable.Range(0, 7).Select(i => Model.InicioSemana.AddDays(i)).First(d => d.DayOfWeek == dow);
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/finanzas/finanzas-shared.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/mapacalor/mapacalor.css" asp-append-version="true" />
}

@* Datos para Chart.js *@
<script type="application/json" id="mc-data-horas-labels">@Html.Raw(etiquetasHoras)</script>
<script type="application/json" id="mc-data-horas-data">@Html.Raw(dataPedidosPorHora)</script>
<script type="application/json" id="mc-data-dias-labels">@Html.Raw(etiquetasDiasSemana)</script>
<script type="application/json" id="mc-data-dias-data">@Html.Raw(dataPedidosPorDiaSemana)</script>
<script type="application/json" id="mc-data-meses-labels">@Html.Raw(etiquetasMeses)</script>
<script type="application/json" id="mc-data-meses-data">@Html.Raw(dataPedidosPorMes)</script>

<div class="admin-page">

    <div class="page-header">
        <div>
            <a asp-area="Admin" asp-controller="Gestion" asp-action="Index" class="back-link">← Dashboard</a>
            <h1>Mapa de Calor de Ventas</h1>
        </div>
    </div>
    <p class="mc-subtitulo">Horas pico y productos más vendidos, en base a pedidos pagados.</p>

    <div class="dash-totales">
        <div class="dash-card dash-card--total">
            <div class="dash-label">Pedidos del día seleccionado</div>
            <div class="dash-valor">@Model.TotalPedidos</div>
        </div>
        <div class="dash-card dash-card--total">
            <div class="dash-label">Total vendido (día seleccionado)</div>
            <div class="dash-valor positivo">$@Model.TotalVendido.ToString("N0")</div>
        </div>
        <div class="dash-card dash-card--total dash-card--kpi">
            <div class="dash-label">Día que más vende (histórico)</div>
            <div class="dash-valor">@(diaMasVendedor?.Etiqueta ?? "—")</div>
        </div>
    </div>

    <div id="seccion-horas" class="row g-4 mb-4 align-items-stretch">
        <div class="col-lg-8 d-flex mc-col-chart">
            <div class="grafica-card flex-fill d-flex flex-column">
                <div class="mc-card-header">
                    <h5 class="mc-card-titulo">Pedidos por hora del día</h5>
                    <form method="get" asp-area="Admin" asp-controller="MapaCalor" asp-action="Index"
                          class="mc-fecha-form" data-scroll-target="seccion-horas">
                        <input type="hidden" name="semanaHistorico" value="@Model.SemanaHistoricoCompleto.ToString().ToLower()" />
                        <input type="hidden" name="semanaOffset" value="@Model.SemanaOffset" />
                        <input type="hidden" name="anioMeses" value="@anioActual" />
                        <input type="hidden" name="mesDetalle" value="@mesActual" />
                        <label for="fecha" class="mc-fecha-label">Día:</label>
                        <input type="date" id="fecha" name="fecha" class="form-control-sm"
                               value="@Model.FechaSeleccionada.ToString("yyyy-MM-dd")"
                               data-autosubmit />
                    </form>
                </div>
                <div class="chart-wrap flex-fill">
                    <canvas id="graficaHoraspico"></canvas>
                </div>
            </div>
        </div>

        <div class="col-lg-4 d-flex mc-col-detalle">
            <div class="grafica-card flex-fill d-flex flex-column">
                <h5 class="mc-card-titulo">Top 10 productos más vendidos</h5>
                @if (!Model.TopProductos.Any())
                {
                    <p class="mc-empty">Aún no hay pedidos pagados para mostrar.</p>
                }
                else
                {
                    <div class="mc-top-lista">
                        @for (int i = 0; i < Model.TopProductos.Count; i++)
                        {
                            var producto = Model.TopProductos[i];
                            var porcentaje = maxCantidadTop > 0 ? (producto.CantidadVendida * 100.0 / maxCantidadTop) : 0;
                            var claseIntensidad = i < 3 ? "mc-top-barra--hot" : "mc-top-barra--warm";
                            <div class="mc-top-item">
                                <span class="mc-top-rank">@(i + 1)</span>
                                <div class="mc-top-info">
                                    <span class="mc-top-nombre">@producto.Nombre</span>
                                    <div class="mc-top-barra-wrap">
                                        <div class="mc-top-barra @claseIntensidad" style="width:@(porcentaje.ToString("0.##"))%"></div>
                                    </div>
                                </div>
                                <span class="mc-top-cant">@producto.CantidadVendida</span>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-12">
            <div class="grafica-card">
                <button class="btn-secondary mc-toggle-historial" type="button"
                        data-bs-toggle="collapse" data-bs-target="#historialDias">
                    Ver historial por día <i class="bi bi-chevron-down"></i>
                </button>
                <div class="collapse" id="historialDias">
                    @if (!Model.HistorialPorDia.Any())
                    {
                        <p class="mc-empty">Aún no hay historial de ventas.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="admin-table">
                                <thead>
                                    <tr>
                                        <th>Fecha</th>
                                        <th>Pedidos</th>
                                        <th>Total Vendido</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var dia in Model.HistorialPorDia)
                                    {
                                        <tr>
                                            <td data-label="Fecha">@dia.Etiqueta</td>
                                            <td data-label="Pedidos">@dia.CantidadPedidos</td>
                                            <td data-label="Total Vendido">$@dia.TotalVendido.ToString("N0")</td>
                                            <td data-label="">
                                                <a asp-area="Admin" asp-controller="MapaCalor" asp-action="Index"
                                                   asp-route-fecha="@dia.Fecha.ToString("yyyy-MM-dd")"
                                                   asp-route-semanaHistorico="@Model.SemanaHistoricoCompleto.ToString().ToLower()"
                                                   asp-route-semanaOffset="@Model.SemanaOffset"
                                                   asp-route-anioMeses="@anioActual"
                                                   asp-route-mesDetalle="@mesActual"
                                                   asp-route-scroll="seccion-horas"
                                                   class="btn-secondary">Ver horas</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div id="seccion-semana" class="row g-4 mb-4">
        <div class="col-12">
            <div class="grafica-card">
                <div class="mc-card-header">
                    <h5 class="mc-card-titulo">Ventas por día de la semana</h5>

                    <div class="mc-nav flex-wrap">
                        <div class="mc-tabs">
                            <a asp-area="Admin" asp-controller="MapaCalor" asp-action="Index"
                               asp-route-fecha="@Model.FechaSeleccionada.ToString("yyyy-MM-dd")"
                               asp-route-semanaHistorico="true"
                               asp-route-semanaOffset="0"
                               asp-route-anioMeses="@anioActual"
                               asp-route-mesDetalle="@mesActual"
                               asp-route-scroll="seccion-semana"
                               class="mc-tab @(Model.SemanaHistoricoCompleto ? "active" : "")">
                                Histórico
                            </a>
                            <a asp-area="Admin" asp-controller="MapaCalor" asp-action="Index"
                               asp-route-fecha="@Model.FechaSeleccionada.ToString("yyyy-MM-dd")"
                               asp-route-semanaHistorico="false"
                               asp-route-semanaOffset="0"
                               asp-route-anioMeses="@anioActual"
                               asp-route-mesDetalle="@mesActual"
                               asp-route-scroll="seccion-semana"
                               class="mc-tab @(!Model.SemanaHistoricoCompleto ? "active" : "")">
                                Por semana
                            </a>
                        </div>

                        @if (!Model.SemanaHistoricoCompleto)
                        {
                            <div class="mc-nav">
                                <a asp-area="Admin" asp-controller="MapaCalor" asp-action="Index"
                                   asp-route-fecha="@Model.FechaSeleccionada.ToString("yyyy-MM-dd")"
                                   asp-route-semanaHistorico="false"
                                   asp-route-semanaOffset="@(Model.SemanaOffset - 1)"
                                   asp-route-anioMeses="@anioActual"
                                   asp-route-mesDetalle="@mesActual"
                                   asp-route-scroll="seccion-semana"
                                   class="mc-nav-btn"><i class="bi bi-chevron-left"></i></a>
                                <span class="mc-nav-chip">@etiquetaRangoSemana</span>
                                <a asp-area="Admin" asp-controller="MapaCalor" asp-action="Index"
                                   asp-route-fecha="@Model.FechaSeleccionada.ToString("yyyy-MM-dd")"
                                   asp-route-semanaHistorico="false"
                                   asp-route-semanaOffset="@(Model.SemanaOffset + 1)"
                                   asp-route-anioMeses="@anioActual"
                                   asp-route-mesDetalle="@mesActual"
                                   asp-route-scroll="seccion-semana"
                                   class="mc-nav-btn"><i class="bi bi-chevron-right"></i></a>
                            </div>
                        }
                    </div>
                </div>

                <div class="row">
                    <div class="col-lg-7 mc-col-chart">
                        <div class="chart-wrap chart-wrap--donut">
                            <canvas id="graficaDiasSemana"></canvas>
                        </div>
                    </div>
                    <div class="col-lg-5 mc-col-detalle">
                        <div class="table-responsive">
                            <table class="admin-table mt-2">
                                <thead>
                                    <tr>
                                        <th>Día</th>
                                        <th>Pedidos</th>
                                        <th>Total Vendido</th>
                                        @if (!Model.SemanaHistoricoCompleto)
                                        {
                                            <th></th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var dia in Model.VentasPorDiaSemana)
                                    {
                                        <tr class="@(dia.DiaSemana == diaMasVendedor?.DiaSemana ? "mc-fila--destacada" : "")">
                                            <td data-label="Día">@dia.Etiqueta</td>
                                            <td data-label="Pedidos">@dia.CantidadPedidos</td>
                                            <td data-label="Total Vendido">$@dia.TotalVendido.ToString("N0")</td>
                                            @if (!Model.SemanaHistoricoCompleto)
                                            {
                                                <td data-label="" class="acciones">
                                                    <a asp-area="Admin" asp-controller="MapaCalor" asp-action="Index"
                                                       asp-route-fecha="@fechaDelDia(dia.DiaSemana).ToString("yyyy-MM-dd")"
                                                       asp-route-semanaHistorico="false"
                                                       asp-route-semanaOffset="@Model.SemanaOffset"
                                                       asp-route-anioMeses="@anioActual"
                                                       asp-route-mesDetalle="@mesActual"
                                                       asp-route-scroll="seccion-horas"
                                                       class="btn-secondary">Ver horas</a>
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr class="mc-fila--total">
                                        <td data-label="">Total</td>
                                        <td data-label="Pedidos">@totalPedidosSemana</td>
                                        <td data-label="Total Vendido">$@totalVendidoSemana.ToString("N0")</td>
                                        @if (!Model.SemanaHistoricoCompleto)
                                        {
                                            <td data-label=""></td>
                                        }
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="seccion-mes" class="row g-4">
        <div class="col-12">
            <div class="grafica-card">
                <div class="mc-card-header">
                    <h5 class="mc-card-titulo">Ventas por mes</h5>

                    <div class="mc-nav">
                        <a asp-area="Admin" asp-controller="MapaCalor" asp-action="Index"
                           asp-route-fecha="@Model.FechaSeleccionada.ToString("yyyy-MM-dd")"
                           asp-route-semanaHistorico="@Model.SemanaHistoricoCompleto.ToString().ToLower()"
                           asp-route-semanaOffset="@Model.SemanaOffset"
                           asp-route-anioMeses="@anioMesAnterior"
                           asp-route-mesDetalle="@mesAnterior"
                           asp-route-scroll="seccion-mes"
                           class="mc-nav-btn"><i class="bi bi-chevron-left"></i></a>
                        <span class="mc-nav-chip">@etiquetaMesActual</span>
                        <a asp-area="Admin" asp-controller="MapaCalor" asp-action="Index"
                           asp-route-fecha="@Model.FechaSeleccionada.ToString("yyyy-MM-dd")"
                           asp-route-semanaHistorico="@Model.SemanaHistoricoCompleto.ToString().ToLower()"
                           asp-route-semanaOffset="@Model.SemanaOffset"
                           asp-route-anioMeses="@anioMesSiguiente"
                           asp-route-mesDetalle="@mesSiguiente"
                           asp-route-scroll="seccion-mes"
                           class="mc-nav-btn @(esHoy ? "disabled" : "")"><i class="bi bi-chevron-right"></i></a>
                    </div>
                </div>

                <div class="row">
                    <div class="col-lg-7 mc-col-chart">
                        <div class="chart-wrap">
                            <canvas id="graficaMeses"></canvas>
                        </div>
                    </div>
                    <div class="col-lg-5 mc-col-detalle">
                        @if (!Model.DiasDelMesSeleccionado.Any())
                        {
                            <p class="mc-empty">No hay ventas registradas en @etiquetaMesActual.</p>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="admin-table mt-2">
                                    <thead>
                                        <tr>
                                            <th>Fecha</th>
                                            <th>Pedidos</th>
                                            <th>Total Vendido</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var dia in Model.DiasDelMesSeleccionado)
                                        {
                                            <tr>
                                                <td data-label="Fecha">@dia.Etiqueta</td>
                                                <td data-label="Pedidos">@dia.CantidadPedidos</td>
                                                <td data-label="Total Vendido">$@dia.TotalVendido.ToString("N0")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script src="~/js/mapa-calor.js" asp-append-version="true"></script>
}