@model List<ProyectoJo.Domain.Entities.Item>

@{
    ViewData["Title"] = "Gestión de Menú";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";

    var busqueda = Context.Request.Query["busqueda"].ToString();
    var categoriaFiltro = Context.Request.Query["categoria"].ToString();
    var categorias = Model.Select(i => i.Categoria).Distinct().OrderBy(c => c).ToList();

    var resultado = Model
        .Where(i => string.IsNullOrEmpty(busqueda) || i.Platillo.Contains(busqueda, StringComparison.OrdinalIgnoreCase))
        .Where(i => string.IsNullOrEmpty(categoriaFiltro) || i.Categoria == categoriaFiltro)
        .ToList();

    const int PorPagina = 12;
    var totalPaginas = (int)Math.Ceiling(resultado.Count / (double)PorPagina);
    var paginaActual = int.TryParse(Context.Request.Query["pagina"], out var p) ? p : 1;
    if (paginaActual < 1) paginaActual = 1;
    if (totalPaginas > 0 && paginaActual > totalPaginas) paginaActual = totalPaginas;

    var paginado = resultado
        .Skip((paginaActual - 1) * PorPagina)
        .Take(PorPagina)
        .ToList();

    var desdeItem = resultado.Any() ? ((paginaActual - 1) * PorPagina) + 1 : 0;
    var hastaItem = ((paginaActual - 1) * PorPagina) + paginado.Count;
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/finanzas/finanzas-shared.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/menu/menu.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/paginador/paginador.css" asp-append-version="true" />
}

<div class="admin-page">
    <div class="page-header">
        <div>
            <a asp-area="Admin" asp-controller="Gestion" asp-action="Index" class="back-link">← Dashboard</a>
            <h1>Menú</h1>
        </div>
    </div>

    <div class="filtro-bar">
        <form method="get" class="filtro-form">
            <input type="text" name="busqueda" value="@busqueda"
                   class="form-control-sm" placeholder="Buscar por nombre..." style="min-width:220px" />
            <select name="categoria" class="form-control-sm" data-autosubmit>
                <option value="">Todas las categorías</option>
                @foreach (var cat in categorias)
                {
                    <option value="@cat" selected="@(cat == categoriaFiltro)">@cat</option>
                }
            </select>
            <button type="submit" class="btn-secondary">
                <i class="bi bi-search"></i>&nbsp; Filtrar
            </button>
            @if (!string.IsNullOrEmpty(busqueda) || !string.IsNullOrEmpty(categoriaFiltro))
            {
                <a asp-area="Admin" asp-controller="Menu" asp-action="Index" class="btn-secondary" title="Limpiar filtros">
                    <i class="bi bi-x-lg"></i>
                </a>
            }
        </form>
        <a asp-area="Admin" asp-controller="Menu" asp-action="Agregar" class="btn-primary">
            Agregar platillo
        </a>
    </div>

    @if (!resultado.Any())
    {
        <div class="empty-state">No se encontraron platillos con esos filtros.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Platillo</th>
                        <th>Categoría</th>
                        <th>Base</th>
                        <th>Precio</th>
                        <th class="text-center">Estado</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in paginado)
                    {
                        <tr>
                            <td data-label="#" style="color:var(--tc-ink-muted)">@item.Id</td>
                            <td data-label="Platillo">@item.Platillo</td>
                            <td data-label="Categoría"><span class="chip-categoria">@item.Categoria</span></td>
                            <td data-label="Base">@item.Base</td>
                            <td data-label="Precio" style="font-family:var(--tc-font-mono)">$@item.Precio.ToString("N2")</td>
                            <td data-label="Estado" class="text-center">
                                <form asp-area="Admin" asp-controller="Inventario"
                                      asp-action="ToggleActivo" asp-route-id="@item.Id" method="post" class="d-inline">
                                    <input type="hidden" name="origen" value="Menu" />
                                    <button type="submit"
                                            class="icon-toggle @(item.Activo ? "on" : "")"
                                            title="@(item.Activo ? "Ocultar" : "Mostrar")">
                                        <i class="bi @(item.Activo ? "bi-eye" : "bi-eye-slash")"></i>
                                    </button>
                                </form>
                                <form asp-area="Admin" asp-controller="Inventario"
                                      asp-action="ToggleAgotado" asp-route-id="@item.Id" method="post" class="d-inline">
                                    <input type="hidden" name="origen" value="Menu" />
                                    <button type="submit"
                                            class="icon-toggle @(item.Agotado ? "warn" : "")"
                                            title="@(item.Agotado ? "Disponible" : "Agotado")"
                                        @(!item.Activo ? "disabled" : "")>
                                        <i class="bi @(item.Agotado ? "bi-x-circle" : "bi-check-circle")"></i>
                                    </button>
                                </form>
                            </td>
                            <td data-label="Acciones">
                                <div class="acciones">
                                    <a asp-area="Admin" asp-controller="Menu" asp-action="Editar"
                                       asp-route-id="@item.Id" class="link-edit">Editar</a>
                                    <form asp-area="Admin" asp-controller="Menu" asp-action="Eliminar"
                                          asp-route-id="@item.Id" method="post"
                                          data-confirm-delete="¿Eliminar @item.Platillo?">
                                        <button type="submit" class="link-delete">Eliminar</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="paginador-resumen">
            Mostrando @desdeItem–@hastaItem de @resultado.Count platillos
        </p>
        @await Html.PartialAsync("_Paginador", (paginaActual, totalPaginas))
    }
</div>