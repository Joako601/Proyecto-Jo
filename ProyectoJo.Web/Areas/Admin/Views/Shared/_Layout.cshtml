<!DOCTYPE html>
<html lang="es">
<head>

    <link rel="stylesheet" href="~/css/admin/admin-style.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <link rel="icon" type="image/png" sizes="32x32" href="~/img/favicon-32.png" asp-append-version="true" />
    <style>
            body {
                background-color: #f8f9fa;
            }

            .sidebar {
                width: 250px;
                height: 100vh;
                position: fixed;
                background: #212529;
                color: white;
            }

            .main-content {
                margin-left: 250px;
                padding: 20px;
            }

            .nav-link {
                color: #adb5bd;
            }

                .nav-link:hover {
                    color: white;
                    background: #343a40;
                }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="sidebar p-3">
        <h4 class="text-white mb-4">Tía Caro Admin</h4>
        <ul class="nav flex-column">
            <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="Gestion" asp-action="Index"><i class="bi bi-house"></i> Dashboard</a></li>
            <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="Menu" asp-action="Index"><i class="bi bi-card-list"></i> Menú</a></li>
            <li class="nav-item"><a class="nav-link" href="#"><i class="bi bi-graph-up"></i> Ventas</a></li>
            <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="Inventario" asp-action="Index"><i class="bi bi-toggles"></i> Inventario</a></li>
            <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="Promociones" asp-action="Index"><i class="bi bi-megaphone"></i> Promociones</a></li>
            <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="MapaCalor" asp-action="Index"><i class="bi bi-fire"></i> Mapa de Calor</a></li>
            <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="CierreCaja" asp-action="Index"><i class="bi bi-cash-coin"></i> Cierre de Caja</a></li>
            <li class="nav-item mt-5"><a class="nav-link text-danger" asp-area="" asp-controller="Home" asp-action="Index"><i class="bi bi-box-arrow-left"></i> Salir</a></li>

        </ul>
    </div>

    <div class="main-content">
        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>