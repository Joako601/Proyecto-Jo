@model IEnumerable<ProyectoJo.Domain.Entities.Finanza>
@using ProyectoJo.Application
@{
    ViewData["Title"] = "Finanzas";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var resumen = ViewBag.Resumen as ProyectoJo.Application.DTOs.ResumenFinanciero;
    int mes = ViewBag.Mes;
    int anio = ViewBag.Anio;
    var meses = System.Globalization.CultureInfo.GetCultureInfo("es-MX").DateTimeFormat.MonthNames;

    var paginado = Model.ToList();
    int paginaActual = ViewBag.PaginaActual;
    int totalPaginas = ViewBag.TotalPaginas;
    int totalMovimientos = ViewBag.TotalMovimientos;

    const int PorPagina = 12;
    var desdeItem = totalMovimientos > 0 ? ((paginaActual - 1) * PorPagina) + 1 : 0;
    var hastaItem = ((paginaActual - 1) * PorPagina) + paginado.Count;
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/finanzas/finanzas-shared.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/finanzas/finanzas-index.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/paginador/paginador.css" asp-append-version="true" />
}

<div class="admin-page">

    <div class="page-header">
        <div>
            <a asp-area="Admin" asp-controller="Gestion" asp-action="Index" class="back-link">← Dashboard</a>
            <h1>Finanzas</h1>
        </div>
        <div class="header-actions">
            <a asp-action="Index" class="tc-tab active">Movimientos</a>
            <a asp-action="Dashboard" class="tc-tab">Dashboard financiero</a>
        </div>
    </div>

    <div class="filtro-bar">
        <form method="get" asp-action="Index" class="filtro-form">
            <select name="mes" class="form-control-sm">
                @for (int i = 1; i <= 12; i++)
                {
                    <option value="@i" selected="@(i == mes ? "selected" : null)">@meses[i - 1]</option>
                }
            </select>
            <select name="anio" class="form-control-sm">
                @for (int a = DateTime.Today.Year; a >= DateTime.Today.Year - 5; a--)
                {
                    <option value="@a" selected="@(a == anio ? "selected" : null)">@a</option>
                }
            </select>
            <button type="submit" class="btn-secondary">Filtrar</button>
        </form>
        <a asp-action="Registrar" class="btn-primary">
            Registrar movimiento
        </a>
    </div>

    @if (resumen != null)
    {
        <div class="resumen-bar">
            <div class="resumen-item resumen-item--ingreso">
                <span class="resumen-label">Ingresos hoy</span>
                <span class="resumen-valor">$@resumen.TotalIngresos.ToString("N2")</span>
            </div>
            <div class="resumen-item resumen-item--egreso">
                <span class="resumen-label">Egresos hoy</span>
                <span class="resumen-valor">$@resumen.TotalEgresos.ToString("N2")</span>
            </div>
            <div class="resumen-item resumen-item--neto">
                <span class="resumen-label">Saldo neto</span>
                <span class="resumen-valor">$@resumen.SaldoNeto.ToString("N2")</span>
            </div>
            <a asp-action="Resumen">Ver resumen por período →</a>
        </div>
    }

    @if (totalMovimientos == 0)
    {
        <p class="empty-state">No hay movimientos registrados en @meses[mes - 1] @anio.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Tipo</th>
                        <th>Categoría</th>
                        <th>Descripción</th>
                        <th>Monto</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in paginado)
                    {
                        <tr>
                            <td data-label="Fecha">@item.Fecha.ToString("dd/MM/yyyy")</td>
                            <td data-label="Tipo">
                                <span class="tag tag--@item.Tipo.ToString().ToLower()">@item.Tipo</span>
                            </td>
                            <td data-label="Categoría">@item.Categoria</td>
                            <td data-label="Descripción">@item.Descripcion</td>
                            <td data-label="Monto">$@item.Monto.ToString("N2")</td>
                            <td data-label="Acciones" class="acciones">
                                <a asp-action="Editar" asp-route-id="@item.Id" class="link-edit">Editar</a>
                                <form asp-action="Eliminar" asp-route-id="@item.Id" method="post" class="form-eliminar">
                                    <button type="submit" class="link-delete">Eliminar</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="paginador-resumen">
            Mostrando @desdeItem–@hastaItem de @totalMovimientos movimientos
        </p>
        @await Html.PartialAsync("_Paginador", (paginaActual, totalPaginas))
    }

</div>

@section Scripts {
    <script src="~/js/finanzas.js" asp-append-version="true"></script>
}