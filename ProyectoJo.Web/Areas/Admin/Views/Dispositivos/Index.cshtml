@model List<ProyectoJo.Domain.Entities.DispositivoOperaciones>
@{
    ViewData["Title"] = "Dispositivos";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var claveConfigurada = ViewBag.ClaveConfigurada is bool cc && cc;
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/finanzas/finanzas-shared.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/dispositivos/dispositivos.css" asp-append-version="true" />
}

<div class="admin-page">

    <div class="page-header">
        <div class="header-left">
            <a asp-area="Admin" asp-controller="Gestion" asp-action="Index" class="back-link">← Dashboard</a>
            <h1>Dispositivos emparejados</h1>
        </div>
        <a class="btn-primary" asp-area="Operaciones" asp-controller="Auth" asp-action="Emparejar" target="_blank">
            + Emparejar nuevo
        </a>
    </div>

    <div class="table-responsive">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Estación</th>
                    <th>Registrado el</th>
                    <th>Token</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model)
                {
                    <tr>
                        <td data-label="Nombre">@(string.IsNullOrWhiteSpace(d.Nombre) ? "(sin nombre)" : d.Nombre)</td>
                        <td data-label="Estación">
                            <span class="tag--@d.Estacion.ToString().ToLower()">@d.Estacion</span>
                        </td>
                        <td data-label="Registrado el">@d.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</td>
                        <td data-label="Token">••••@(d.Token.Length >= 6 ? d.Token[^6..] : d.Token)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!Model.Any())
    {
        <p class="empty-state">Todavía no se emparejó ningún dispositivo.</p>
    }

    <div class="clave-supervisor">
        <h2 class="clave-supervisor__titulo">Clave de supervisor</h2>

        @if (!claveConfigurada)
        {
            <div class="clave-supervisor__aviso">
                <i class="bi bi-exclamation-triangle"></i>
                Todavía no hay clave configurada. Sin ella no se pueden emparejar dispositivos desde el kiosco.
            </div>
        }

        @if (TempData["ErrorClave"] is string errorClave)
        {
            <div class="clave-supervisor__mensaje clave-supervisor__mensaje--error">@errorClave</div>
        }
        @if (TempData["ExitoClave"] is string exitoClave)
        {
            <div class="clave-supervisor__mensaje clave-supervisor__mensaje--exito">@exitoClave</div>
        }

        <form method="post" asp-area="Admin" asp-controller="Dispositivos" asp-action="CambiarClaveSupervisor">
            @if (claveConfigurada)
            {
                <div class="clave-supervisor__campo">
                    <label>Clave actual</label>
                    <input type="password" name="claveActual" autocomplete="off" />
                </div>
            }
            <div class="clave-supervisor__campo">
                <label>Clave nueva</label>
                <input type="password" name="claveNueva" autocomplete="off" minlength="6" required />
            </div>
            <div class="clave-supervisor__campo">
                <label>Confirmar clave nueva</label>
                <input type="password" name="confirmarClaveNueva" autocomplete="off" minlength="6" required />
            </div>
            <button type="submit" class="btn-primary">
                @(claveConfigurada ? "Cambiar clave" : "Configurar clave")
            </button>
        </form>
    </div>

</div>