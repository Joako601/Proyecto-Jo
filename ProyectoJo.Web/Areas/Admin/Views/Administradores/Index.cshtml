@model List<ProyectoJo.Domain.Entities.Administrador>
@{
    ViewData["Title"] = "Administradores";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var todasLasAreas = ProyectoJo.Domain.Entities.AreasAdmin.Todas;
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/usuarios/usuarios.css" asp-append-version="true" />
}

<div class="admin-page">

    <div class="page-header">
        <div class="header-left">
            <a asp-area="Admin" asp-controller="Gestion" asp-action="Index" class="back-link">← Dashboard</a>
            <h1>Administradores</h1>
        </div>
    </div>

    @if (TempData["Error"] is string error)
    {
        <div class="usuarios-mensaje usuarios-mensaje--error">@error</div>
    }
    @if (TempData["Exito"] is string exito)
    {
        <div class="usuarios-mensaje usuarios-mensaje--exito">@exito</div>
    }

    <details class="filtro-bar filtro-bar--solo">
        <summary class="btn-primary">+ Nuevo administrador</summary>
        <form method="post" asp-area="Admin" asp-controller="Administradores" asp-action="Crear">
            <label>Usuario</label>
            <input type="text" name="usuario" required autocomplete="off" />

            <label>Contraseña</label>
            <input type="password" name="contrasena" required minlength="8" autocomplete="new-password" />

            <label>Clave de supervisor (PIN para operadores)</label>
            <input type="password" name="claveSupervisor" required minlength="6" autocomplete="new-password" />

            <label><input type="checkbox" name="general" value="true" /> Acceso general (todas las áreas)</label>

            <fieldset>
                <legend>O elegí áreas puntuales:</legend>
                @foreach (var area in todasLasAreas)
                {
                    <label><input type="checkbox" name="areas" value="@area" /> @area</label>
                }
            </fieldset>

            <button type="submit" class="btn-primary">Crear</button>
        </form>
    </details>

    <div class="table-responsive">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Usuario</th>
                    <th>Activo</th>
                    <th>Acceso</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model)
                {
                    <tr>
                        <td data-label="Usuario">@a.Usuario</td>
                        <td data-label="Activo">@(a.Activo ? "Sí" : "No")</td>
                        <td data-label="Acceso">@(a.Areas.Any() ? string.Join(", ", a.Areas) : "General")</td>
                        <td>
                            <details>
                                <summary class="link-edit">Editar</summary>
                                <form method="post" asp-area="Admin" asp-controller="Administradores" asp-action="Editar">
                                    <input type="hidden" name="id" value="@a.Id" />

                                    <label>Usuario</label>
                                    <input type="text" name="usuario" value="@a.Usuario" required />

                                    <label><input type="checkbox" name="activo" value="true" checked="@a.Activo" /> Activo</label>

                                    <label>Nueva contraseña (opcional)</label>
                                    <input type="password" name="nuevaContrasena" minlength="8" autocomplete="new-password" />

                                    <label>Nueva clave de supervisor (opcional)</label>
                                    <input type="password" name="nuevaClaveSupervisor" minlength="6" autocomplete="new-password" />

                                    <label>
                                        <input type="checkbox" name="general" value="true" checked="@(!a.Areas.Any())" />
                                        Acceso general (todas las áreas)
                                    </label>

                                    <fieldset>
                                        <legend>O áreas puntuales:</legend>
                                        @foreach (var area in todasLasAreas)
                                        {
                                            <label>
                                                <input type="checkbox" name="areas" value="@area" checked="@a.Areas.Contains(area)" />
                                                @area
                                            </label>
                                        }
                                    </fieldset>

                                    <button type="submit" class="btn-primary">Guardar</button>
                                </form>
                            </details>
                            <form method="post" asp-area="Admin" asp-controller="Administradores" asp-action="Eliminar"
                                  data-confirm-delete="¿Eliminar a @a.Usuario?" style="display:inline">
                                <input type="hidden" name="id" value="@a.Id" />
                                <button type="submit" class="link-delete">Eliminar</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!Model.Any())
    {
        <p class="empty-state">Todavía no hay administradores creados.</p>
    }

</div>