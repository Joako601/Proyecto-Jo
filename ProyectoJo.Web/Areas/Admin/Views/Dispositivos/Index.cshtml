@model List<ProyectoJo.Domain.Entities.DispositivoOperaciones>
@{
    ViewData["Title"] = "Dispositivos";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/finanzas/finanzas-shared.css" asp-append-version="true" />
}

<div class="admin-page">

    <div class="page-header">
        <div class="header-left">
            <a asp-area="Admin" asp-controller="Gestion" asp-action="Index" class="back-link">← Dashboard</a>
            <h1>Dispositivos emparejados</h1>
        </div>
        <a class="btn-primary" asp-area="Operaciones" asp-controller="Auth" asp-action="Emparejar" target="_blank">
            + Emparejar nuevo
        </a>
    </div>

    <table class="admin-table">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Estación</th>
                <th>Registrado el</th>
                <th>Token</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in Model)
            {
                <tr>
                    <td>@(string.IsNullOrWhiteSpace(d.Nombre) ? "(sin nombre)" : d.Nombre)</td>
                    <td>
                        <span class="tag--@d.Estacion.ToString().ToLower()">@d.Estacion</span>
                    </td>
                    <td>@d.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>••••@(d.Token.Length >= 6 ? d.Token[^6..] : d.Token)</td>
                </tr>
            }
        </tbody>
    </table>

    @if (!Model.Any())
    {
        <p class="empty-state">Todavía no se emparejó ningún dispositivo.</p>
    }

</div>