@model ProyectoJo.Domain.Entities.Finanza
@{
    ViewData["Title"] = "Registrar Movimiento";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/finanzas/finanzas-shared.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/finanzas/finanzas-form.css" asp-append-version="true" />
}

<div class="admin-form">
    <div class="form-header">
        <a asp-action="Index" class="back-link">← Volver</a>
        <h1>Registrar Movimiento</h1>
    </div>

    <form asp-action="Registrar" method="post">
        <div class="form-group">
            <label asp-for="Tipo">Tipo</label>
            <select asp-for="Tipo" class="form-control">
                <option value="Ingreso">Ingreso</option>
                <option value="Egreso">Egreso</option>
            </select>
        </div>
        <div class="form-group">
            <label asp-for="Monto">Monto</label>
            <input asp-for="Monto" type="number" step="0.01" class="form-control" />
            <span asp-validation-for="Monto" class="field-error"></span>
        </div>
        <div class="form-group">
            <label asp-for="Categoria">Categoría</label>
            <select id="selectCategoria" name="Categoria" class="form-control">
                <option value="">Seleccioná una categoría...</option>
                @foreach (var cat in (List<string>)ViewBag.Categorias)
                {
                    <option value="@cat">@cat</option>
                }
                <option value="__nueva__">+ Crear nueva categoría...</option>
            </select>
            <input id="inputCategoriaNueva" class="form-control mt-2" style="display:none;"
                   placeholder="Ej. Insumos, Renta, Venta" />
            <span asp-validation-for="Categoria" class="field-error"></span>
        </div>
        <div class="form-group">
            <label asp-for="Descripcion">Descripción</label>
            <input asp-for="Descripcion" type="text" class="form-control" />
        </div>
        <div class="form-group">
            <label asp-for="Fecha">Fecha</label>
            <input asp-for="Fecha" type="date" class="form-control"
                   value="@DateTime.Today.ToString("yyyy-MM-dd")"
                   max="@DateTime.Today.ToString("yyyy-MM-dd")" />
        </div>
        <div class="form-actions">
            <button type="submit" class="btn-primary">Guardar</button>
            <a asp-action="Index" class="btn-cancel">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/finanzas.js" asp-append-version="true"></script>
    <script src="~/js/menu-categoria-form.js" asp-append-version="true"></script>
}