@model ProyectoJo.Domain.Entities.CierreCaja
@{
    ViewData["Title"] = "Cerrar Caja";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/finanzas/finanzas-shared.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/finanzas/finanzas-form.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/cierre-caja/cierre-caja.css" asp-append-version="true" />
}

<div class="admin-form">
    <div class="form-header">
        <a asp-action="Index" class="back-link">← Volver</a>
        <h1>Cerrar Caja</h1>
    </div>

    <p class="empty-state" style="padding: 0 0 1rem; text-align:left; color:#777;">
        Caja abierta desde el @Model.FechaApertura.ToString("dd/MM/yyyy HH:mm").
        Las ventas y gastos se calculan automáticamente con lo registrado en Finanzas desde esa fecha.
    </p>

    <div class="resumen-cierre">
        <div class="resumen-cierre-item">
            <span>Fondo inicial</span>
            <span>$@Model.FondoInicial.ToString("N2")</span>
        </div>
        <div class="resumen-cierre-item">
            <span>Ventas del turno</span>
            <span>$@Model.VentasDelDia.ToString("N2")</span>
        </div>
        <div class="resumen-cierre-item">
            <span>Gastos del turno</span>
            <span>$@Model.GastosDelDia.ToString("N2")</span>
        </div>
        <div class="resumen-cierre-item">
            <span>&nbsp;</span>
            <span>&nbsp;</span>
        </div>
        <div class="resumen-cierre-item resumen-cierre-item--esperado">
            <span>Total en caja</span>
            <span>$@Model.Total.ToString("N2")</span>
        </div>
    </div>

    <form asp-action="Cerrar" asp-route-id="@Model.Id" method="post">
        <div class="form-group">
            <label for="notas">Notas (opcional)</label>
            <input id="notas" name="notas" type="text" class="form-control"
                   placeholder="Ej. Turno sin novedades" />
        </div>
        <div class="form-actions">
            <button type="submit" class="btn-primary">Confirmar cierre</button>
            <a asp-action="Index" class="btn-cancel">Cancelar</a>
        </div>
    </form>
</div>