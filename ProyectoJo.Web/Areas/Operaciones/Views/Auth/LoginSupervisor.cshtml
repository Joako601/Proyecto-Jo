@{
    Layout = "_Layout";
    ViewData["Title"] = "Clave de supervisor";
    var bloqueado = ViewBag.Bloqueado is bool b && b;
}

<div class="d-flex justify-content-center align-items-center" style="min-height: 90vh;">
    <div class="card shadow-sm" style="max-width: 380px; width: 100%;">
        <div class="card-body p-4 text-center">

            <span class="badge bg-secondary mb-2 px-3 py-2">
                <i class="bi bi-shield-lock"></i>
                Supervisor
            </span>

            <h4 class="mb-1">Clave de supervisor</h4>
            <p class="text-muted small mb-3">Necesaria para reconfigurar este dispositivo</p>

            @if (ViewBag.Error is string error)
            {
                <div class="alert alert-danger py-2">@error</div>
            }

            <form method="post" asp-area="Operaciones" asp-controller="Auth" asp-action="LoginSupervisor">
                <div class="mb-3">
                    <input type="password"
                           name="clave"
                           class="form-control form-control-lg text-center @(bloqueado ? "disabled" : "")"
                           autocomplete="off"
                           autofocus
                    @(bloqueado ? "disabled" : "") />
                </div>

                <button type="submit" class="btn btn-dark btn-tactil w-100" @(bloqueado ? "disabled" : "")>
                    Continuar
                </button>
            </form>
        </div>
    </div>
</div>