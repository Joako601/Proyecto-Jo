@{
    ViewData["Title"] = "Abrir Caja";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/finanzas/finanzas-shared.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/finanzas/finanzas-form.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/cierre-caja/cierre-caja.css" asp-append-version="true" />
}

<div class="admin-form">
    <div class="form-header">
        <a asp-action="Index" class="back-link">← Volver</a>
        <h1>Abrir Caja</h1>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert-error">
            @foreach (var error in ViewData.ModelState.SelectMany(kv => kv.Value!.Errors))
            {
                <p class="mb-0">@error.ErrorMessage</p>
            }
        </div>
    }

    <form asp-action="Abrir" method="post">
        <div class="form-group">
            <label for="fondoInicial">Fondo inicial</label>
            <input id="fondoInicial" name="fondoInicial" type="number" step="0.01" min="0"
                   class="form-control" placeholder="Ej. 500.00" required />
        </div>
        <div class="form-group">
            <label for="notas">Notas (opcional)</label>
            <input id="notas" name="notas" type="text" class="form-control"
                   placeholder="Ej. Turno matutino" />
        </div>
        <div class="form-actions">
            <button type="submit" class="btn-primary">Abrir caja</button>
            <a asp-action="Index" class="btn-cancel">Cancelar</a>
        </div>
    </form>
</div>