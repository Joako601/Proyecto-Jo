@model ProyectoJo.Web.Models.MenuItemViewModel

@{
    var item = Model.Platillo;
}

@section Styles {
    <link rel="stylesheet" href="~/css/detalles/detalle.css" asp-append-version="true" />
}
<div class="container detalle-container module-reveal">
    <div class="platillo-wrapper shadow-lg">

        <div class="platillo-visual">
            @if (string.IsNullOrEmpty(item.ImagenUrl))
            {
                <!-- TODO: reemplazar con foto propia del negocio (sprint de fotografía) -->
                <div class="d-flex flex-column align-items-center justify-content-center text-center">
                    <span class="platillo-visual-icono">&#10047;</span>
                    <p class="text-uppercase mt-3 mb-0 platillo-visual-titulo">Próximamente</p>
                    <p class="text-uppercase mt-1 platillo-visual-subtitulo">Foto en camino</p>
                </div>
            }
            else
            {
                <img src="@item.ImagenUrl" alt="@item.Platillo" class="platillo-visual-img" />
            }
        </div>

        <div class="platillo-info">
            <header class="platillo-info-header">
                <span class="tag-categoria">@item.Categoria</span>
                <h1 class="titulo-premium">@item.Platillo</h1>
                @if (Model.TienePromocion)
                {
                    <span class="precio-premium precio-premium-anterior text-decoration-line-through text-muted">$@item.Precio</span>
                    <span class="precio-premium">$@Model.PrecioFinal</span>
                }
                else
                {
                    <span class="precio-premium">$@item.Precio</span>
                }
            </header>

            <p class="descripcion-premium">
                "@item.Descripcion"
            </p>

            <div class="ficha-tecnica">
                <div class="ficha-item">
                    <label>Ingredientes</label>
                    <span>@item.Ingredientes</span>
                </div>
                <div class="ficha-item">
                    <label>Origen</label>
                    <span>San Pedro Uxmal</span>
                </div>
            </div>

            <a asp-action="Index" class="btn-regresar-yerba">
                Volver al Menú
            </a>
        </div>
    </div>
</div>