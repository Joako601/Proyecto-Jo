@model ProyectoJo.Domain.Entities.Promocion

@{
    ViewData["Title"] = "Editar promoción";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    
    var platillos = (ViewBag.Platillos as List<ProyectoJo.Domain.Entities.Item>) ?? new List<ProyectoJo.Domain.Entities.Item>();
}

@section Styles {
    <link rel="stylesheet" href="~/Areas/Admin/css/admin/promociones/promociones.css" asp-append-version="true" />
}

<div class="mb-4">
    <a asp-area="Admin" asp-controller="Promociones" asp-action="Index" class="text-muted text-decoration-none">
        <i class="bi bi-arrow-left"></i> Volver a promociones
    </a>
</div>

<h2 class="mb-4">Editar promoción</h2>

<div class="row">
    <div class="col-md-8">
        <form asp-area="Admin" asp-controller="Promociones" asp-action="Editar" method="post">
            <input asp-for="Id" type="hidden" />

            <div class="mb-3">
                <label asp-for="Titulo" class="form-label">Título</label>
                <input asp-for="Titulo" class="form-control" />
                <span asp-validation-for="Titulo" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Descripcion" class="form-label">Descripción</label>
                <textarea asp-for="Descripcion" class="form-control" rows="2"></textarea>
                <span asp-validation-for="Descripcion" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ImagenUrl" class="form-label">
                    Imagen del banner
                    <span class="text-muted fw-normal small ms-1">(URL pública, opcional)</span>
                </label>
                <input asp-for="ImagenUrl" class="form-control"
                       placeholder="https://ejemplo.com/imagen-promo.jpg"
                       id="ImagenUrl" />
                <small class="text-muted">Si no agregas imagen, el banner usará el color de acento del sitio.</small>
                <span asp-validation-for="ImagenUrl" class="text-danger small"></span>

                <div class="banner-preview-wrapper mt-2">
                    <img id="banner-preview-img" class="banner-preview-img" src="" alt="Vista previa" hidden />
                    <div id="banner-preview-placeholder" class="banner-preview-placeholder">
                        <i class="bi bi-image"></i>
                        Vista previa del banner
                    </div>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Tipo de descuento</label>
                <select asp-for="TipoDescuento" class="form-select">
                    <option value="Ninguno">Ninguno (solo anuncio / banner)</option>
                    <option value="Porcentaje">Porcentaje (%)</option>
                    <option value="MontoFijo">Monto fijo ($)</option>
                </select>
                <span asp-validation-for="TipoDescuento" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ValorDescuento" class="form-label">Valor del descuento</label>
                <input asp-for="ValorDescuento" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="ValorDescuento" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Platillos a los que aplica</label>
                <div class="border rounded p-2" style="max-height: 220px; overflow-y: auto;">
                    @if (!platillos.Any())
                    {
                        <p class="text-muted small mb-0">No hay platillos disponibles.</p>
                    }
                    else
                    {
                        @foreach (var item in platillos)
                        {
                            
                            var marcado = Model.ItemIds?.Contains(item.Id) == true;
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="ItemIds" value="@item.Id"
                                       id="item-@item.Id" checked="@marcado" />
                                <label class="form-check-label" for="item-@item.Id">@item.Platillo (@item.Categoria)</label>
                            </div>
                        }
                    }
                </div>
                <small class="text-muted">Si no marcas ningún platillo, la promoción se muestra como anuncio general en el menú.</small>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="FechaInicio" class="form-label">Fecha inicio (opcional)</label>
                    <input asp-for="FechaInicio" type="date" class="form-control"
                           value="@(Model.FechaInicio?.ToString("yyyy-MM-dd"))" />
                    <span asp-validation-for="FechaInicio" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="FechaFin" class="form-label">Fecha fin (opcional)</label>
                    <input asp-for="FechaFin" type="date" class="form-control"
                           value="@(Model.FechaFin?.ToString("yyyy-MM-dd"))" />
                    <span asp-validation-for="FechaFin" class="text-danger small"></span>
                </div>
            </div>

            <div class="form-check form-switch mb-4">
                <input class="form-check-input" type="checkbox" asp-for="Activa" />
                <label asp-for="Activa" class="form-check-label">Activa</label>
            </div>

            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-lg"></i> Guardar cambios
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script src="~/Areas/Admin/js/promociones-form.js" asp-append-version="true"></script>
}