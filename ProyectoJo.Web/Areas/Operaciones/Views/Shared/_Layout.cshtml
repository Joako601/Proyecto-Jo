<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
    <title>@ViewData["Title"] — Proyecto Jo' Operaciones</title>
    <link rel="manifest" href="~/manifest.json">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <link rel="icon" type="image/png" href="~/img/logo.png" asp-append-version="true" />
    <style>
            body {
                background-color: #f4f1ec;
                -webkit-tap-highlight-color: transparent;
                user-select: none;
            }

            .op-navbar {
                background: #212529;
                color: white;
                padding: 12px 20px;
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

                .op-navbar .badge-estacion {
                    font-size: 0.95rem;
                    padding: 6px 14px;
                }

            .btn-tactil {
                min-height: 56px;
                font-size: 1.1rem;
                font-weight: 600;
            }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="op-navbar">
            <span><i class="bi bi-person-badge"></i> @User.Identity.Name</span>
            <span class="badge bg-secondary badge-estacion">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span>
            <a class="btn btn-sm btn-outline-light" asp-area="Operaciones" asp-controller="Auth" asp-action="Salir">
                <i class="bi bi-box-arrow-right"></i> Salir
            </a>
        </div>
    }

    <div class="container-fluid p-3">
        @RenderBody()
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>