@{
    ViewData["Title"] = "Quiénes Somos - Tía Caro";
}

@section Styles {
    <link rel="stylesheet" href="~/css/nosotros/index.css" asp-append-version="true" />
}

<div class="nosotros-hero">
    <div class="container py-5">
        <p class="subtitulo">Nuestra Esencia</p>
        <h1 class="display-4">Quiénes Somos</h1>
        <div class="divider-gold"></div>
        <p class="descripcion">
            En San Pedro Uxmal, Mérida, no solo cocinamos antojitos; preservamos historias.
            Somos un equipo apasionado por la gastronomía yucateca y el servicio de excelencia.
        </p>
    </div>
</div>

<div class="nosotros-seccion">
    <div class="nosotros-foto-wrap">
        <img src="https://images.unsplash.com/photo-1581092160562-40aa08e78837?q=80&w=1000&auto=format&fit=crop"
             class="nosotros-foto" alt="Joaquin Uriona" />
    </div>
    <div class="nosotros-texto-wrap">
        <div class="nosotros-texto">
            <h3>Joaquin Uriona</h3>
            <p class="rol">Coder &amp; Modernización</p>
            <p class="bio">
                Impulsor de la modernización de Tía Caro, fusionando las recetas ancestrales
                de Mérida con una gestión tecnológica de vanguardia para llevar el sabor
                yucateco al siguiente nivel.
            </p>
        </div>
    </div>
</div>

<div class="nosotros-seccion">
    <div class="nosotros-texto-wrap">
        <div class="nosotros-texto">
            <h3>Josue &amp; Ariff</h3>
            <p class="rol">Arquitectura &amp; Experiencia</p>
            <p class="bio">
                Responsables de la infraestructura y el flujo operativo que garantiza
                que cada pedido y cada visita a nuestra plataforma sea tan fluida como
                el servicio en nuestras mesas.
            </p>
        </div>
    </div>
    <div class="nosotros-foto-wrap">
        <img src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?q=80&w=1000&auto=format&fit=crop"
             class="nosotros-foto" alt="Josue y Ariff" />
    </div>
</div>

<div class="nosotros-seccion">
    <div class="nosotros-foto-wrap">
        <img src="https://images.unsplash.com/photo-1552566626-52f8b828add9?q=80&w=1000&auto=format&fit=crop"
             class="nosotros-foto" alt="Yisus y Mateeo" />
    </div>
    <div class="nosotros-texto-wrap">
        <div class="nosotros-texto">
            <h3>Yisus &amp; Mateeo</h3>
            <p class="rol">Logística &amp; Control de Calidad</p>
            <p class="bio">
                Expertos en asegurar que los estándares de frescura y sabor se cumplan
                rigurosamente, supervisando desde la selección de ingredientes hasta
                la entrega final al comensal.
            </p>
        </div>
    </div>
</div>