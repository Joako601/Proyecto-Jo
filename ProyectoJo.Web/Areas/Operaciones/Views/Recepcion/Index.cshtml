@using Microsoft.AspNetCore.Antiforgery
@inject IAntiforgery Antiforgery
@{
    Layout = null;
    var tokenSet = Antiforgery.GetAndStoreTokens(Context);
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
    <meta name="request-verification-token" content="@tokenSet.RequestToken">
    <link rel="manifest" href="~/manifest.json">
    <title>Recepción — Proyecto Jo'</title>
    <link rel="stylesheet" href="~/css/operaciones/recepcion.css" asp-append-version="true">
</head>
<body>
    <div class="top-bar">
        <div class="top-bar__brand">
            <span class="top-bar__icon">🧾</span>
            <h1 class="top-bar__title">Recepción</h1>
        </div>
        <a class="top-bar__salir" asp-area="Operaciones" asp-controller="Auth" asp-action="Salir">
            Cerrar sesión <span class="top-bar__empleado">(@User.Identity?.Name)</span>
        </a>
    </div>

    <div class="layout">
        <section class="col-menu">
            <h2 class="seccion-titulo">Menú del negocio</h2>
            <div id="menu-contenedor">
                <p class="mensaje-vacio">Cargando menú...</p>
            </div>
        </section>

        <aside class="col-carrito">
            <h2 class="seccion-titulo">Pedido actual</h2>
            <div class="carrito-box">
                <div class="tipo-entrega">
                    <button id="btn-mesa" class="tipo-entrega__btn tipo-entrega__btn--activo" data-tipo="mesa">
                        Para mesa
                    </button>
                    <button id="btn-llevar" class="tipo-entrega__btn" data-tipo="llevar">
                        Para llevar
                    </button>
                </div>

                <input id="mesa-input" class="mesa-input" placeholder="Número o nombre de mesa">

                <div id="carrito-lineas">
                    <p class="mensaje-vacio">Aún no has agregado productos.</p>
                </div>

                <div class="total" id="total-carrito">Total: $0.00</div>
                <button class="crear-btn" id="crear-btn" disabled>Crear pedido</button>
            </div>
        </aside>
    </div>

    <div class="tabs">
        <button id="tab-activos" class="tabs__btn tabs__btn--activo" data-tab="activos">Pedidos activos</button>
        <button id="tab-pagados" class="tabs__btn" data-tab="pagados">Pagados</button>
    </div>

    <div id="pedidos-grid" class="pedidos-grid">
        <p class="mensaje-vacio">Cargando pedidos...</p>
    </div>

    
    <div id="modal-confirmacion" style="display:none;position:fixed;inset:0;z-index:1000;align-items:center;justify-content:center;">
        <div id="modal-overlay" style="position:absolute;inset:0;background:rgba(0,0,0,0.5);"></div>
        <div style="position:relative;background:#fff;border-radius:12px;padding:1.5rem;max-width:420px;width:90%;box-shadow:0 8px 32px rgba(0,0,0,0.2);">
            <h3 id="modal-titulo" style="margin:0 0 1rem;font-size:1.1rem;color:#111;"></h3>
            <p id="modal-cuerpo" style="margin:0 0 1.5rem;font-size:0.95rem;color:#444;line-height:1.5;"></p>
            <div style="display:flex;gap:0.75rem;justify-content:flex-end;">
                <button id="modal-cancelar" style="padding:0.5rem 1.25rem;border:1px solid #d1d5db;border-radius:8px;background:#fff;cursor:pointer;font-size:0.9rem;">Cancelar</button>
                <button id="modal-confirmar" style="padding:0.5rem 1.25rem;border:none;border-radius:8px;background:#2563eb;color:#fff;cursor:pointer;font-size:0.9rem;">Enviar sin ellos</button>
            </div>
        </div>
    </div>

    <script src="~/lib/signalr/signalr.min.js"></script>
    <script src="~/js/operaciones/recepcion.js" asp-append-version="true"></script>
</body>
</html>