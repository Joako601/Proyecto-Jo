@model ProyectoJo.Domain.Entities.Promocion

@{
    ViewData["Title"] = "Editar promoción";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var platillos = (ViewBag.Platillos as List<ProyectoJo.Domain.Entities.Item>) ?? new List<ProyectoJo.Domain.Entities.Item>();
    var esPermanente = Model.FechaInicio == null && Model.FechaFin == null;
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/finanzas/finanzas-shared.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/finanzas/finanzas-form.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/promociones/promociones.css" asp-append-version="true" />
}

<div class="admin-form promo-form" style="max-width: 640px;">
    <div class="form-header">
        <a asp-area="Admin" asp-controller="Promociones" asp-action="Index" class="back-link">← Volver a promociones</a>
        <h1>Editar promoción</h1>
    </div>

    <form asp-area="Admin" asp-controller="Promociones" asp-action="Editar" method="post">
        <input asp-for="Id" type="hidden" />

        <div class="form-group">
            <label asp-for="Titulo">Título</label>
            <input asp-for="Titulo" class="form-control" />
            <span asp-validation-for="Titulo" class="field-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Descripcion">Descripción</label>
            <textarea asp-for="Descripcion" class="form-control" rows="2"></textarea>
            <span asp-validation-for="Descripcion" class="field-error"></span>
        </div>

        <input type="hidden" asp-for="TipoDescuento" id="TipoDescuento" />

        @{
            var tipoUiInicial = Model.TipoDescuento == ProyectoJo.Domain.Entities.TipoDescuento.Ninguno
                ? "Banner"
                : Model.TipoDescuento.ToString();
        }

        <div class="form-group" id="campo-imagen">
            <label asp-for="ImagenUrl">
                Imagen del banner
                <span class="text-muted fw-normal" style="text-transform:none; letter-spacing:0;">(opcional)</span>
            </label>

            <div class="banner-dropzone" id="banner-dropzone">
                <input type="file" id="banner-file-input" accept="image/*" hidden />
                <i class="bi bi-cloud-arrow-up"></i>
                <p class="banner-dropzone__texto">
                    Arrastrá una imagen acá o <span class="banner-dropzone__link">hacé clic para elegir un archivo</span>
                </p>
            </div>
            <span class="promo-hint" id="banner-upload-status"></span>

            <input asp-for="ImagenUrl" class="form-control mt-2"
                   placeholder="...o pegá una URL pública: https://ejemplo.com/imagen-promo.jpg"
                   id="ImagenUrl" />
            <span class="promo-hint">Si no agregás imagen, el banner usará el color de acento del sitio.</span>
            <span asp-validation-for="ImagenUrl" class="field-error"></span>

            <div class="banner-preview-wrapper mt-2">
                <img id="banner-preview-img" class="banner-preview-img" src="" alt="Vista previa" hidden />
                <div id="banner-preview-placeholder" class="banner-preview-placeholder">
                    <i class="bi bi-image"></i>
                    Vista previa del banner
                </div>
            </div>
        </div>

        <div class="form-group">
            <label for="tipoDescuentoUi">Tipo de descuento</label>
            <select id="tipoDescuentoUi" class="form-control">
                <option value="Banner" selected="@(tipoUiInicial == "Banner")">Banner</option>
                <option value="Porcentaje" selected="@(tipoUiInicial == "Porcentaje")">Porcentaje (%)</option>
                <option value="MontoFijo" selected="@(tipoUiInicial == "MontoFijo")">Monto fijo ($)</option>
            </select>
        </div>

        <div class="form-check form-switch tc-switch-row" id="campo-aplicar-platillos">
            <input class="form-check-input" type="checkbox" id="aplicarDescuento" />
            <label for="aplicarDescuento">Aplicar también a platillos específicos</label>
        </div>

        <div class="form-group" id="campo-tipo-descuento-real">
            <label for="tipoDescuentoReal">¿También querés aplicar un descuento?</label>
            <select id="tipoDescuentoReal" class="form-control">
                <option value="Porcentaje">Porcentaje (%)</option>
                <option value="MontoFijo">Monto fijo ($)</option>
            </select>
        </div>

        <div class="form-group" id="campo-descuento">
            <label asp-for="ValorDescuento">
                Valor del descuento <span id="valorDescuentoUnidad" class="text-muted"></span>
            </label>
            <input asp-for="ValorDescuento" type="number" step="0.01" class="form-control" />
            <span asp-validation-for="ValorDescuento" class="field-error"></span>
        </div>

        <div class="form-group">
            <label>Platillos a los que aplica</label>
            <div class="promo-checklist">
                @if (!platillos.Any())
                {
                    <p class="text-muted small mb-0">No hay platillos disponibles.</p>
                }
                else
                {
                    @foreach (var item in platillos)
                    {
                        var marcado = Model.ItemIds?.Contains(item.Id) == true;
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="ItemIds" value="@item.Id"
                                   id="item-@item.Id" checked="@marcado" />
                            <label class="form-check-label" for="item-@item.Id">@item.Platillo (@item.Categoria)</label>
                        </div>
                    }
                }
            </div>
            <span class="promo-hint">Si no marcás ningún platillo, la promoción se muestra como anuncio general en el menú.</span>
        </div>

        <hr class="promo-divider" />

        <div class="row">
            <div class="col-md-6 form-group">
                <label asp-for="FechaInicio">Fecha inicio</label>
                <input asp-for="FechaInicio" type="date" class="form-control" id="FechaInicio"
                       value="@(Model.FechaInicio?.ToString("yyyy-MM-dd"))" />
                <span asp-validation-for="FechaInicio" class="field-error"></span>
            </div>
            <div class="col-md-6 form-group">
                <label asp-for="FechaFin">Fecha fin</label>
                <input asp-for="FechaFin" type="date" class="form-control" id="FechaFin"
                       value="@(Model.FechaFin?.ToString("yyyy-MM-dd"))" />
                <span asp-validation-for="FechaFin" class="field-error"></span>
            </div>
        </div>

        <div class="form-check form-switch tc-switch-row">
            <input class="form-check-input" type="checkbox" id="siempreActiva" checked="@esPermanente" />
            <label for="siempreActiva">Siempre activa (sin fecha de vencimiento)</label>
        </div>

        <div class="form-check form-switch tc-switch-row">
            <input class="form-check-input" type="checkbox" asp-for="Activa" />
            <label asp-for="Activa">Activa</label>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-primary">Guardar cambios</button>
            <a asp-area="Admin" asp-controller="Promociones" asp-action="Index" class="btn-cancel">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/promociones-form.js" asp-append-version="true"></script>
}