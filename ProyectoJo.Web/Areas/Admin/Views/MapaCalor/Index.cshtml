@model ProyectoJo.Application.DTOs.ResumenMapaCalor
@{
    ViewData["Title"] = "Mapa de Calor de Ventas";
    Layout = "_Layout";

    var etiquetasHoras = System.Text.Json.JsonSerializer.Serialize(Model.VentasPorHora.Select(v => v.Etiqueta));
    var dataPedidosPorHora = System.Text.Json.JsonSerializer.Serialize(Model.VentasPorHora.Select(v => v.CantidadPedidos));

    var etiquetasDiasSemana = System.Text.Json.JsonSerializer.Serialize(Model.VentasPorDiaSemana.Select(v => v.Etiqueta));
    var dataPedidosPorDiaSemana = System.Text.Json.JsonSerializer.Serialize(Model.VentasPorDiaSemana.Select(v => v.CantidadPedidos));

    var diaMasVendedor = Model.VentasPorDiaSemana.OrderByDescending(v => v.TotalVendido).FirstOrDefault();

    var etiquetaRangoSemana = $"{Model.InicioSemana:dd/MM} - {Model.FinSemana:dd/MM/yyyy}";

    var etiquetasMeses = System.Text.Json.JsonSerializer.Serialize(Model.VentasPorMes.Select(v => v.Etiqueta));
    var dataPedidosPorMes = System.Text.Json.JsonSerializer.Serialize(Model.VentasPorMes.Select(v => v.CantidadPedidos));

    var mesActual = Model.MesDetalleSeleccionado ?? DateTime.Today.Month;
    var anioActual = Model.AnioMesesSeleccionado > 0 ? Model.AnioMesesSeleccionado : DateTime.Today.Year;

    var mesAnterior = mesActual == 1 ? 12 : mesActual - 1;
    var anioMesAnterior = mesActual == 1 ? anioActual - 1 : anioActual;
    var mesSiguiente = mesActual == 12 ? 1 : mesActual + 1;
    var anioMesSiguiente = mesActual == 12 ? anioActual + 1 : anioActual;
    var esHoy = anioActual == DateTime.Today.Year && mesActual == DateTime.Today.Month;

    var cultura = new System.Globalization.CultureInfo("es-MX");
    var etiquetaMesActual = cultura.DateTimeFormat.GetMonthName(mesActual) + " " + anioActual;
}

<div class="container-fluid py-4">
    <h2 class="mb-1">Mapa de Calor de Ventas</h2>
    <p class="text-muted mb-4">Horas pico y productos más vendidos, en base a pedidos pagados.</p>

    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card p-3 shadow-sm border-0 bg-primary text-white">
                <h6>Pedidos del día seleccionado</h6>
                <h2 class="mt-2">@Model.TotalPedidos</h2>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card p-3 shadow-sm border-0 bg-success text-white">
                <h6>Total Vendido (día seleccionado)</h6>
                <h2 class="mt-2">$@Model.TotalVendido.ToString("N0")</h2>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card p-3 shadow-sm border-0 bg-warning">
                <h6>Día que más vende (histórico)</h6>
                <h2 class="mt-2">@(diaMasVendedor?.Etiqueta ?? "—")</h2>
            </div>
        </div>
    </div>

    <div id="seccion-horas" class="row g-4 mb-4 align-items-stretch">
        <div class="col-lg-8 d-flex">
            <div class="card shadow-sm border-0 p-4 flex-fill d-flex flex-column">
                <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                    <h5 class="mb-0">Pedidos por hora del día</h5>
                    <form method="get" asp-area="Admin" asp-controller="MapaCalor" asp-action="Index"
                          class="d-flex align-items-center gap-2" data-scroll-target="seccion-horas">
                        <input type="hidden" name="semanaHistorico" value="@Model.SemanaHistoricoCompleto.ToString().ToLower()" />
                        <input type="hidden" name="semanaOffset" value="@Model.SemanaOffset" />
                        <input type="hidden" name="anioMeses" value="@anioActual" />
                        <input type="hidden" name="mesDetalle" value="@mesActual" />
                        <label for="fecha" class="small text-muted mb-0">Día:</label>
                        <input type="date" id="fecha" name="fecha" class="form-control form-control-sm"
                               value="@Model.FechaSeleccionada.ToString("yyyy-MM-dd")"
                               onchange="this.form.submit()" />
                    </form>
                </div>
                <div class="flex-fill">
                    <canvas id="graficaHoraspico"></canvas>
                </div>
            </div>
        </div>

        <div class="col-lg-4 d-flex">
            <div class="card shadow-sm border-0 p-4 flex-fill d-flex flex-column">
                <h5 class="mb-3">Top 10 productos más vendidos</h5>
                @if (!Model.TopProductos.Any())
                {
                    <p class="text-muted small">Aún no hay pedidos pagados para mostrar.</p>
                }
                else
                {
                    <ol class="list-group list-group-flush flex-fill">
                        @foreach (var producto in Model.TopProductos)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <span>@producto.Nombre</span>
                                <span class="badge bg-primary rounded-pill">@producto.CantidadVendida</span>
                            </li>
                        }
                    </ol>
                }
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-12">
            <div class="card shadow-sm border-0 p-4">
                <button class="btn btn-sm btn-outline-secondary mb-3" type="button"
                        data-bs-toggle="collapse" data-bs-target="#historialDias">
                    Ver historial por día <i class="bi bi-chevron-down"></i>
                </button>
                <div class="collapse" id="historialDias">
                    @if (!Model.HistorialPorDia.Any())
                    {
                        <p class="text-muted small">Aún no hay historial de ventas.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle">
                                <thead>
                                    <tr>
                                        <th>Fecha</th>
                                        <th class="text-end">Pedidos</th>
                                        <th class="text-end">Total Vendido</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var dia in Model.HistorialPorDia)
                                    {
                                        <tr>
                                            <td>@dia.Etiqueta</td>
                                            <td class="text-end">@dia.CantidadPedidos</td>
                                            <td class="text-end">$@dia.TotalVendido.ToString("N0")</td>
                                            <td class="text-end">
                                                <a asp-area="Admin" asp-controller="MapaCalor" asp-action="Index"
                                                   asp-route-fecha="@dia.Fecha.ToString("yyyy-MM-dd")"
                                                   asp-route-semanaHistorico="@Model.SemanaHistoricoCompleto.ToString().ToLower()"
                                                   asp-route-semanaOffset="@Model.SemanaOffset"
                                                   asp-route-anioMeses="@anioActual"
                                                   asp-route-mesDetalle="@mesActual"
                                                   asp-route-scroll="seccion-horas"
                                                   class="btn btn-sm btn-outline-primary">Ver horas</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div id="seccion-semana" class="row g-4 mb-4">
        <div class="col-12">
            <div class="card shadow-sm border-0 p-4">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3">
                    <h5 class="mb-0">Ventas por día de la semana</h5>

                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <div class="btn-group btn-group-sm" role="group">
                            <a asp-area="Admin" asp-controller="MapaCalor" asp-action="Index"
                               asp-route-fecha="@Model.FechaSeleccionada.ToString("yyyy-MM-dd")"
                               asp-route-semanaHistorico="true"
                               asp-route-semanaOffset="0"
                               asp-route-anioMeses="@anioActual"
                               asp-route-mesDetalle="@mesActual"
                               asp-route-scroll="seccion-semana"
                               class="btn @(Model.SemanaHistoricoCompleto ? "btn-primary" : "btn-outline-primary")">
                                Histórico
                            </a>
                            <a asp-area="Admin" asp-controller="MapaCalor" asp-action="Index"
                               asp-route-fecha="@Model.FechaSeleccionada.ToString("yyyy-MM-dd")"
                               asp-route-semanaHistorico="false"
                               asp-route-semanaOffset="0"
                               asp-route-anioMeses="@anioActual"
                               asp-route-mesDetalle="@mesActual"
                               asp-route-scroll="seccion-semana"
                               class="btn @(!Model.SemanaHistoricoCompleto ? "btn-primary" : "btn-outline-primary")">
                                Por semana
                            </a>
                        </div>

                        @if (!Model.SemanaHistoricoCompleto)
                        {
                            <div class="btn-group btn-group-sm" role="group">
                                <a asp-area="Admin" asp-controller="MapaCalor" asp-action="Index"
                                   asp-route-fecha="@Model.FechaSeleccionada.ToString("yyyy-MM-dd")"
                                   asp-route-semanaHistorico="false"
                                   asp-route-semanaOffset="@(Model.SemanaOffset - 1)"
                                   asp-route-anioMeses="@anioActual"
                                   asp-route-mesDetalle="@mesActual"
                                   asp-route-scroll="seccion-semana"
                                   class="btn btn-outline-secondary">&larr;</a>
                                <span class="btn btn-light disabled">@etiquetaRangoSemana</span>
                                <a asp-area="Admin" asp-controller="MapaCalor" asp-action="Index"
                                   asp-route-fecha="@Model.FechaSeleccionada.ToString("yyyy-MM-dd")"
                                   asp-route-semanaHistorico="false"
                                   asp-route-semanaOffset="@(Model.SemanaOffset + 1)"
                                   asp-route-anioMeses="@anioActual"
                                   asp-route-mesDetalle="@mesActual"
                                   asp-route-scroll="seccion-semana"
                                   class="btn btn-outline-secondary">&rarr;</a>
                            </div>
                        }
                    </div>
                </div>

                <div class="row">
                    <div class="col-lg-7">
                        <canvas id="graficaDiasSemana" height="120"></canvas>
                    </div>
                    <div class="col-lg-5">
                        <table class="table table-sm align-middle mt-2">
                            <thead>
                                <tr>
                                    <th>Día</th>
                                    <th class="text-end">Pedidos</th>
                                    <th class="text-end">Total Vendido</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var dia in Model.VentasPorDiaSemana)
                                {
                                    <tr class="@(dia.DiaSemana == diaMasVendedor?.DiaSemana ? "table-success" : "")">
                                        <td>@dia.Etiqueta</td>
                                        <td class="text-end">@dia.CantidadPedidos</td>
                                        <td class="text-end">$@dia.TotalVendido.ToString("N0")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="seccion-mes" class="row g-4">
        <div class="col-12">
            <div class="card shadow-sm border-0 p-4">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3">
                    <h5 class="mb-0">Ventas por mes</h5>

                    <div class="d-flex align-items-center gap-2">
                        <div class="btn-group btn-group-sm" role="group">
                            <a asp-area="Admin" asp-controller="MapaCalor" asp-action="Index"
                               asp-route-fecha="@Model.FechaSeleccionada.ToString("yyyy-MM-dd")"
                               asp-route-semanaHistorico="@Model.SemanaHistoricoCompleto.ToString().ToLower()"
                               asp-route-semanaOffset="@Model.SemanaOffset"
                               asp-route-anioMeses="@anioMesAnterior"
                               asp-route-mesDetalle="@mesAnterior"
                               asp-route-scroll="seccion-mes"
                               class="btn btn-outline-secondary">&larr;</a>
                            <span class="btn btn-light disabled" style="min-width:140px">@etiquetaMesActual</span>
                            <a asp-area="Admin" asp-controller="MapaCalor" asp-action="Index"
                               asp-route-fecha="@Model.FechaSeleccionada.ToString("yyyy-MM-dd")"
                               asp-route-semanaHistorico="@Model.SemanaHistoricoCompleto.ToString().ToLower()"
                               asp-route-semanaOffset="@Model.SemanaOffset"
                               asp-route-anioMeses="@anioMesSiguiente"
                               asp-route-mesDetalle="@mesSiguiente"
                               asp-route-scroll="seccion-mes"
                               class="btn btn-outline-secondary @(esHoy ? "disabled" : "")">&rarr;</a>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-lg-7">
                        <canvas id="graficaMeses" height="120"></canvas>
                    </div>
                    <div class="col-lg-5">
                        @if (!Model.DiasDelMesSeleccionado.Any())
                        {
                            <p class="text-muted small mt-2">No hay ventas registradas en @etiquetaMesActual.</p>
                        }
                        else
                        {
                            <table class="table table-sm align-middle mt-2">
                                <thead>
                                    <tr>
                                        <th>Fecha</th>
                                        <th class="text-end">Pedidos</th>
                                        <th class="text-end">Total Vendido</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var dia in Model.DiasDelMesSeleccionado)
                                    {
                                        <tr>
                                            <td>@dia.Etiqueta</td>
                                            <td class="text-end">@dia.CantidadPedidos</td>
                                            <td class="text-end">$@dia.TotalVendido.ToString("N0")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
    (function () {
        'use strict';

        // Scroll suave a la sección indicada en ?scroll=
        var params = new URLSearchParams(window.location.search);
        var scrollTarget = params.get('scroll');
        if (scrollTarget) {
            var el = document.getElementById(scrollTarget);
            if (el) {
                requestAnimationFrame(function () {
                    el.scrollIntoView({ behavior: 'smooth', block: 'start' });
                });
            }
        }

        // Formularios con data-scroll-target inyectan ?scroll= al hacer submit
        document.querySelectorAll('form[data-scroll-target]').forEach(function (form) {
            form.addEventListener('submit', function () {
                var hidden = document.createElement('input');
                hidden.type = 'hidden';
                hidden.name = 'scroll';
                hidden.value = form.dataset.scrollTarget;
                form.appendChild(hidden);
            });
        });

        new Chart(document.getElementById('graficaHoraspico'), {
            type: 'bar',
            data: {
                labels: @Html.Raw(etiquetasHoras),
                datasets: [{ label: 'Pedidos pagados', data: @Html.Raw(dataPedidosPorHora), backgroundColor: 'rgba(13, 110, 253, 0.7)', borderRadius: 4 }]
            },
            options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { precision: 0 } } } }
        });

        new Chart(document.getElementById('graficaDiasSemana'), {
            type: 'bar',
            data: {
                labels: @Html.Raw(etiquetasDiasSemana),
                datasets: [{ label: 'Pedidos pagados', data: @Html.Raw(dataPedidosPorDiaSemana), backgroundColor: 'rgba(255, 193, 7, 0.8)', borderRadius: 4 }]
            },
            options: { responsive: true, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { precision: 0 } } } }
        });

        new Chart(document.getElementById('graficaMeses'), {
            type: 'bar',
            data: {
                labels: @Html.Raw(etiquetasMeses),
                datasets: [{ label: 'Pedidos pagados', data: @Html.Raw(dataPedidosPorMes), backgroundColor: 'rgba(25, 135, 84, 0.8)', borderRadius: 4 }]
            },
            options: { responsive: true, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { precision: 0 } } } }
        });
    }());
    </script>
}