@model ProyectoJo.Domain.Entities.Item

@{
    ViewData["Title"] = "Editar platillo";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/finanzas/finanzas-shared.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/finanzas/finanzas-form.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/recetario/recetario.css" asp-append-version="true" />
}

<div class="admin-form">
    <div class="form-header">
        <a asp-area="Admin" asp-controller="Menu" asp-action="Index" class="back-link">← Volver al menú</a>
        <h1>Editar platillo</h1>
    </div>

    <form asp-area="Admin" asp-controller="Menu" asp-action="Editar" method="post">
        <input asp-for="Id" type="hidden" />

        <div class="form-group">
            <label asp-for="Platillo">Nombre del platillo</label>
            <input asp-for="Platillo" class="form-control" />
            <span asp-validation-for="Platillo" class="field-error"></span>
        </div>
        <div class="form-group">
            <label asp-for="Categoria">Categoría</label>
            <select id="selectCategoria" name="Categoria" class="form-control">
                <option value="">Seleccioná una categoría...</option>
                @foreach (var cat in (List<string>)ViewBag.Categorias)
                {
                    <option value="@cat" selected="@(cat == Model.Categoria)">@cat</option>
                }
                <option value="__nueva__">+ Crear nueva categoría...</option>
            </select>
            <input id="inputCategoriaNueva" class="form-control mt-2" style="display:none;" placeholder="Nombre de la nueva categoría" />
            <span asp-validation-for="Categoria" class="field-error"></span>
        </div>
        <div class="form-group">
            <label asp-for="Base">Base</label>
            <input asp-for="Base" class="form-control" />
            <span asp-validation-for="Base" class="field-error"></span>
        </div>
        <div class="form-group">
            <label asp-for="Precio">Precio</label>
            <input asp-for="Precio" class="form-control" type="number" step="0.01" />
            <span asp-validation-for="Precio" class="field-error"></span>
        </div>
        <div class="form-group">
            <label>Ingredientes</label>
            <input asp-for="Ingredientes" type="hidden" id="inputIngredientesOculto" />

            <table class="admin-table receta-ingredientes-table" id="tablaIngredientesMenu">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
            <button type="button" class="btn-secondary" id="btnAgregarIngredienteMenu">
                Agregar ingrediente
            </button>

            <span asp-validation-for="Ingredientes" class="field-error"></span>
            <span class="promo-hint">Solo el nombre — la cantidad, unidad y costo se cargan en el Recetario.</span>
        </div>
        <div class="form-group">
            <label asp-for="Descripcion">Descripción</label>
            <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Descripcion" class="field-error"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-primary">
                <i class="bi bi-check-lg"></i>&nbsp; Guardar cambios
            </button>
            <a asp-area="Admin" asp-controller="Menu" asp-action="Index" class="btn-secondary">
                Cancelar
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/menu-ingredientes-form.js" asp-append-version="true"></script>
    <script src="~/js/menu-categoria-form.js" asp-append-version="true"></script>
}